#!/usr/bin/env ruby
# frozen_string_literal: true

# Usage: B2_ENDPOINT=... B2_BUCKET=... B2_KEY_ID=... B2_KEY=... script/upload_pdfs_to_b2 [SOURCE] [ACCOUNTS_YAML]
# Defaults: ~/Documents/Beancount and ~/.frijolero/accounts.yaml. Pass --dry-run to print the plan only.

require 'bundler/setup'
require_relative '../lib/frijolero'

dry_run = ARGV.include?('--dry-run')
ARGV.delete('--dry-run')

source = ARGV[0] || File.expand_path('~/Documents/Beancount')
accounts_file = ARGV[1] || File.expand_path('~/.frijolero/accounts.yaml')

unless File.directory?(source)
  warn "Source directory does not exist: #{source}"
  exit 1
end

unless File.exist?(accounts_file)
  warn "Accounts file does not exist: #{accounts_file}"
  exit 1
end

uploader = Frijolero::PdfUploader.new(
  source: source,
  accounts_file: accounts_file,
  b2_client: nil # will be set below if not dry-run
)

plan = uploader.plan

if dry_run
  plan.each do |path, key|
    puts "#{path} → #{key}"
  end
  exit 0
end

b2 = Frijolero::B2.from_env
uploader = Frijolero::PdfUploader.new(
  source: source,
  accounts_file: accounts_file,
  b2_client: b2
)

result = uploader.run

skipped_count = result.skipped.size
puts "Uploaded #{result.uploaded.size}, skipped #{skipped_count}"

if skipped_count.positive?
  result.skipped.each do |skip|
    puts "skip #{skip}"
  end
  exit 1
end

exit 0
