#!/usr/bin/env ruby
# frozen_string_literal: true

# Usage: script/build_ledger_repo [SOURCE] [TARGET]
#   (defaults: ~/Documents/Beancount → ~/Developer/beancount-ledger)

require_relative '../lib/frijolero'

source = ARGV[0] || File.expand_path('~/Documents/Beancount')
target = ARGV[1] || File.expand_path('~/Developer/beancount-ledger')

report = Frijolero::LedgerBuilder.new(
  source: source,
  target: target,
  frijolero_dir: File.expand_path('~/.frijolero')
).run

puts "Copied #{report.copied} files"
report.warnings.each { |warning| puts "warning: #{warning}" }
exit 1 if report.warnings.any?
