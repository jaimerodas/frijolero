{
  "name": "transactions",
  "strict": true,
  "schema": {
    "type": "object",
    "properties": {
      "transactions": {
        "type": "array",
        "description": "A list of financial transactions.",
        "items": {
          "type": "object",
          "properties": {
            "date": {
              "type": "string",
              "description": "The date of the transaction in YYYY-MM-DD format.",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "amount": {
              "type": "number",
              "description": "Amount of the transaction, can include decimals."
            },
            "description": {
              "type": "string",
              "description": "Description of the transaction."
            }
          },
          "required": ["date", "amount", "description"],
          "additionalProperties": false
        }
      },
      "closing_balance": {
        "type": ["number", "null"],
        "description": "The balance at the closing date that the movements lead to, with their sign: what is owed is negative. null when the statement prints none."
      }
    },
    "required": ["transactions", "closing_balance"],
    "additionalProperties": false
  }
}
