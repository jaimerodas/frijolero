# The deployment of the author: change the 1Password account and item, or
# replace this file with another Kamal secrets adapter (see kamal secrets --help).
#
# Kamal reads this file when it deploys. Every secret comes from the 1Password
# item "Frijolero" in the Developer vault, through the `op` CLI (one auth per
# deploy). Nothing secret lives in the repo. One command per line: Kamal's
# parser does not understand backslash continuations.
#
# Item fields expected: kamal_registry_password, openai_api_key, session_secret,
# postmark_api_token, b2_key_id, b2_application_key, git_token, admin_email.
# The fetch line must name every field that an extract line reads.
SECRETS=$(kamal secrets fetch --adapter 1password --account rodas.1password.com --from Developer/Frijolero kamal_registry_password openai_api_key session_secret postmark_api_token b2_key_id b2_application_key git_token admin_email)

KAMAL_REGISTRY_PASSWORD=$(kamal secrets extract kamal_registry_password $SECRETS)
OPENAI_API_KEY=$(kamal secrets extract openai_api_key $SECRETS)
SESSION_SECRET=$(kamal secrets extract session_secret $SECRETS)
POSTMARK_API_TOKEN=$(kamal secrets extract postmark_api_token $SECRETS)
S3_KEY_ID=$(kamal secrets extract b2_key_id $SECRETS)
S3_KEY=$(kamal secrets extract b2_application_key $SECRETS)
GIT_TOKEN=$(kamal secrets extract git_token $SECRETS)
ADMIN_EMAIL=$(kamal secrets extract admin_email $SECRETS)
