<%
  journal_href = ->(name) { "/journal?account=#{Rack::Utils.escape(name)}&#{report_query(period, sort: nil)}" }
  cell = lambda do |row, currency|
    value = figure(row[:amounts][currency] * sign)
    next value if value.empty? || Frijolero::Reports::SYNTHETIC.include?(row[:name])

    %(<a href="#{h(journal_href.(row[:name]))}">#{value}</a>)
  end
  root, rows = rows.partition { |row| row[:depth].zero? }
  # An empty section keeps its title row and reads 0.00, not a bare header.
  root = [{ name: title, amounts: Hash.new(0) }] if root.empty?
%>
<div class="table-wrap">
  <table class="report">
    <thead>
      <% root.each do |row| %>
        <tr class="root">
          <th scope="row"><%= h(title) %></th>
          <% currencies.each do |currency| %><td class="amount" data-label="<%= h(currency) %>"><%= (v = cell.(row, currency)).empty? ? datum(0) : v %></td><% end %>
        </tr>
      <% end %>
      <% unless rows.empty? %>
      <tr class="cols">
        <th><%= sort_link('name', 'Cuenta', period) %></th>
        <% currencies.each do |currency| %><th class="amount"><%= sort_link(currency, h(currency), period) %></th><% end %>
      </tr>
      <% end %>
    </thead>
    <tbody>
      <% rows.each do |row| %>
        <tr data-account="<%= h(row[:name]) %>" data-depth="<%= row[:depth] %>"<% if row[:total] %> class="total"<% end %><% if row[:depth] > 1 %> hidden<% end %>>
          <th scope="row" style="--depth: <%= row[:depth] - 1 %>"><% if row[:total] %><button type="button" class="fold" aria-expanded="false"><%= h(row[:name].split(':').last) %></button><% else %><%= h(row[:name].split(':').last) %><% end %></th>
          <% currencies.each do |currency| %><td class="amount" data-label="<%= h(currency) %>"><%= cell.(row, currency) %></td><% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
