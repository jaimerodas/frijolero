<!DOCTYPE html>
<html lang="es">
<head>
  <%= head('Mi cuenta') %>
  <script src="/reports.js" defer></script>
</head>
<body>
  <%= bar %>
  <main>
    <h1><%= h(user.name || user.email) %></h1>
    <% if user.name %><p class="meta"><%= h(user.email) %></p><% end %>
    <% if notice %>
      <p class="notice" role="status"><%= h(notice) %></p>
    <% end %>
    <% if error %>
      <p class="error" role="alert"><%= h(error) %></p>
    <% end %>

    <%# Every error of this page is about the email. %>
    <details class="profile-edit"<% if error %> open<% end %>>
      <summary class="button">Editar</summary>
      <form method="post" action="/profile/name">
        <label for="name">Nombre</label>
        <div class="row">
          <input type="text" id="name" name="name" value="<%= h(user.name) %>" maxlength="80" autocomplete="name">
          <button type="submit">Guardar</button>
        </div>
      </form>
      <form method="post" action="/profile/email">
        <label for="email">Correo nuevo</label>
        <div class="row">
          <input type="email" id="email" name="email" autocomplete="email" required>
          <button type="submit" data-busy="Mandando…">Mandar enlace</button>
        </div>
        <p class="note">Tu correo cambia cuando entras con el enlace que te llega.</p>
      </form>
    </details>

    <h2>Ledgers</h2>
    <%= erb :_person_ledgers, layout: false, locals: { ledgers: Frijolero::Ledger.owned_by(user.id) } %>
    <p class="actions"><a class="button" href="/ledgers/new">Nuevo ledger</a></p>

    <h2>Uso del modelo</h2>
    <%= erb :_usage, layout: false, locals: { person: user } %>

    <h2>Llaves de acceso</h2>
    <p>Entra con Face ID, Touch ID o el PIN de tu dispositivo, sin esperar un correo.</p>
    <p class="files"><a href="/passkeys">Llaves de acceso</a></p>
  </main>
</body>
</html>
