<%
  h = ->(s) { Rack::Utils.escape_html(s.to_s) }
  key_path = Rack::Utils.escape_path(key)
  fmt_size = lambda do |bytes|
    bytes < 1_000_000 ? "#{bytes / 1000}\u00a0KB" : format('%.1f\u00a0MB', bytes / 1_000_000.0)
  end
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <%= head(key) %>
</head>
<body>
  <%= topbar %>
  <main>
    <%= erb :_cuentas, layout: false %>
    <%= erb :_account, layout: false, locals: { account: key, tab: :statements } %>

    <% if error %>
      <p class="error" role="alert"><%= h.(error) %></p>
    <% elsif rows.empty? %>
      <p>No hay PDFs en B2. <a href="/upload">Sube el primero.</a></p>
    <% else %>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Periodo</th>
              <th>Tamaño</th>
              <th>PDF</th>
              <th>Estado</th>
            </tr>
          </thead>
          <tbody>
            <% rows.each do |row| %>
              <tr>
                <th scope="row"><%= h.(period_name(row[:period])) %></th>
                <% if row[:missing] %>
                <td colspan="2"></td>
                <td data-label="Estado"><a class="status missing" href="/upload">falta</a></td>
                <% else %>
                <td data-label="Tamaño"><%= h.(fmt_size.(row[:size])) %></td>
                <td data-label="PDF"><a class="button" href="/accounts/<%= key_path %>/<%= row[:period] %>/pdf">Descargar</a></td>
                <td data-label="Estado">
                  <% if row[:processed] %>
                    <a class="button" href="/accounts/<%= key_path %>/<%= row[:period] %>">Ver</a>
                  <% else %>
                    <span class="note">sin procesar</span>
                  <% end %>
                </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </main>
</body>
</html>
