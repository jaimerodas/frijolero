<%
  v = ->(name) { h(values[name]) }
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <%= head('Nueva cuenta') %>
</head>
<body>
  <%= topbar %>
  <main>
    <%= erb :_cuentas, layout: false %>
    <h1>Nueva cuenta</h1>
    <% if error %>
      <p class="error" role="alert"><%= h(error) %></p>
    <% end %>
    <% if prompt_types.empty? %>
      <p class="error" role="alert">El ledger no tiene <code>config/prompts/</code>. Corre <code>bin/new-ledger &lt;ruta del ledger&gt;</code> en la laptop, que agrega lo que falta, y haz push. Ver <a href="https://github.com/jaimerodas/frijolero/blob/main/docs/setup.md#si-ya-tienes-un-ledger">docs/setup.md</a>.</p>
    <% end %>
    <form method="post" action="/accounts/new">
      <label for="key">Clave</label>
      <input type="text" id="key" name="key" value="<%= v.('key') %>" required autofocus>
      <p class="note">El nombre del archivo: <code>Clave YYMM.pdf</code></p>

      <label for="description">Descripción</label>
      <input type="text" id="description" name="description" value="<%= v.('description') %>" size="40">
      <p class="note">Lo que lee el clasificador para reconocer el estado de cuenta</p>

      <label for="beancount_account">Cuenta Beancount</label>
      <input type="text" id="beancount_account" name="beancount_account" value="<%= v.('beancount_account') %>" list="ledger-accounts"
             pattern="(Assets|Liabilities|Equity|Income|Expenses)(:[A-Z][A-Za-z0-9-]*)+" placeholder="Assets:Banco" required>
      <datalist id="ledger-accounts"><% ledger_accounts.each do |account| %><option value="<%= h(account) %>"><% end %></datalist>
      <p class="note">Empieza con <code>Assets</code> (una cuenta de banco), <code>Liabilities</code> (una tarjeta de crédito), <code>Income</code>, <code>Expenses</code> o <code>Equity</code>. Cada nivel va después de dos puntos, con mayúscula inicial, sin espacios ni acentos: <code>Assets:BBVA:Cheques</code>.</p>

      <label for="openai_prompt_type">Tipo de prompt</label>
      <select id="openai_prompt_type" name="openai_prompt_type">
        <% prompt_types.each do |type| %>
          <option value="<%= h(type) %>"<%= ' selected' if type == values['openai_prompt_type'] %>><%= h(type) %></option>
        <% end %>
      </select>
      <p class="note">Para un banco o una tarjeta, <code>default</code>. Los demás son los prompts especiales de <code>config/prompts/</code> del ledger.</p>

      <label for="cutoff_day">Día de corte</label>
      <input type="number" id="cutoff_day" name="cutoff_day" value="<%= v.('cutoff_day') %>" min="1" max="31">
      <p class="note">Opcional. El primer estado de cuenta lo llena solo. 31 es el último día del mes.</p>

      <label for="opened_on">Fecha de apertura</label>
      <input type="date" id="opened_on" name="opened_on" value="<%= v.('opened_on') %>" required>

      <p class="actions"><button type="submit" class="primary"<%= ' disabled' if prompt_types.empty? %>>Crear</button> <a class="button" href="/accounts">Cancelar</a></p>
    </form>
  </main>
</body>
</html>
