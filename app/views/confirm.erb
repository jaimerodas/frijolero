<!DOCTYPE html>
<html lang="es">
<head>
  <%= head %>
</head>
<body>
  <%= topbar %>
  <main>
    <%= erb :_cuentas, layout: false %>
    <h1><%= h(filename) %></h1>
    <% if result.period_start && result.period_end %>
      <p class="meta">Periodo impreso: <%= h(result.period_start) %> a <%= h(result.period_end) %></p>
    <% end %>

    <form method="post" action="/upload/confirm">
      <label for="account">Cuenta</label>
      <select id="account" name="account" required>
        <option value=""></option>
        <% accounts.each do |account| %>
          <option value="<%= h(account) %>" <%= 'selected' if !result.unknown? && account == result.account %>>
            <%= h(account) %>
          </option>
        <% end %>
      </select>

      <label for="period">Periodo (YYMM)</label>
      <input type="text" id="period" name="period" pattern="\d{4}" required value="<%= h(result.period) %>">

      <input type="hidden" name="token" value="<%= h(token) %>">
      <input type="hidden" name="period_end" value="<%= h(result.period_end) %>">
      <input type="hidden" name="overwrite" value="<%= h(overwrite) %>">

      <% if self.class.client %>
        <p class="note">Revisa antes de procesar: la extracción cuesta dinero.</p>
      <% else %>
        <p class="error" role="alert">Falta <code><%= Frijolero::LLM.key_var %></code>: sin ella la app solo guarda el PDF.</p>
      <% end %>

      <p class="actions">
        <% if self.class.client %><button type="submit" class="primary">Procesar</button><% end %>
        <button type="submit"<%= ' class="primary"' unless self.class.client %> formaction="/upload/backup">Solo guardar PDF</button>
      </p>
    </form>
  </main>
</body>
</html>
