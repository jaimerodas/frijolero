<!DOCTYPE html>
<html lang="es">
<head>
  <%= head %>
</head>
<body>
  <%= topbar %>
  <main>
    <%= erb :_cuentas, layout: false %>
    <h1>Subir estado de cuenta</h1>
    <% unless self.class.client %>
      <p class="error" role="alert">Falta <code><%= Frijolero::LLM.key_var %></code>: sin ella la app no clasifica ni extrae. Un PDF llamado <code>Clave YYMM.pdf</code> se puede guardar sin procesarlo.</p>
    <% end %>
    <form method="post" action="/upload" enctype="multipart/form-data">
      <label for="pdf">PDF</label>
      <input type="file" id="pdf" name="pdf" accept="application/pdf" required>

      <label>
        <input type="checkbox" name="overwrite">
        Sobrescribir si ya existe
      </label>

      <p class="actions"><button type="submit" class="primary">Clasificar</button></p>
    </form>
  </main>
</body>
</html>
