<%# The closing line of a report: the same root row as a table's head, on its own. %>
<table class="report closing" aria-label="<%= h(title) %>">
  <thead>
    <tr class="root">
      <th scope="row"><%= h(title) %></th>
      <% currencies.each do |currency| %><td class="amount" data-label="<%= h(currency) %>"><%= datum(net[currency]) %></td><% end %>
    </tr>
  </thead>
</table>
