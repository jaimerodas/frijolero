<%
  usage = Frijolero::Usage
  last_month = Date.today.prev_month.to_time
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <%= head('Usuarios') %>
  <script src="/reports.js" defer></script>
</head>
<body>
  <%= bar %>
  <main>
    <h1>Usuarios</h1>
    <% if notice %>
      <p class="notice" role="status"><%= h(notice) %></p>
    <% end %>
    <% if error %>
      <p class="error" role="alert"><%= h(error) %></p>
    <% end %>

    <details class="invite"<% if inviting %> open<% end %>>
      <summary class="button">Invitar a alguien</summary>
      <form method="post" action="/admin/invite">
        <div class="row">
          <div>
            <label for="email">Correo</label>
            <input type="email" id="email" name="email" autocomplete="off" required>
          </div>
          <div>
            <label for="name">Nombre (opcional)</label>
            <input type="text" id="name" name="name" autocomplete="off">
          </div>
          <button type="submit" class="primary" data-busy="Invitando…">Invitar</button>
        </div>
        <p class="note">Le llega un correo con un enlace para entrar, que sirve una vez durante 7 días.</p>
      </form>
    </details>

    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Usuario</th>
            <th>Estado</th>
            <th>Ledgers</th>
            <th>Tope (USD)</th>
            <th>Este mes</th>
            <th>Mes pasado</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% users.each do |person| %>
            <% glyph, word = Frijolero::Admin::STATUS[person.status] %>
            <tr>
              <th scope="row"><a href="/admin/users/<%= person.id %>"><% if person.name %><%= h(person.name) %> <span class="note"><%= h(person.email) %></span><% else %><%= h(person.email) %><% end %></a></th>
              <td data-label="Estado"><span class="status <%= glyph %>"><%= word %></span></td>
              <td data-label="Ledgers"><%= h(Frijolero::Ledger.owned_by(person.id).map(&:name).join(', ')) %></td>
              <td data-label="Tope (USD)">
                <form class="row-actions" method="post" action="/admin/users/<%= person.id %>/cap">
                  <input name="cap" value="<%= usage.usd(usage.cap_micros(person.id)) %>" inputmode="decimal" size="6" aria-label="Tope de <%= h(person.email) %> en dólares">
                  <button type="submit">Guardar</button>
                </form>
              </td>
              <td data-label="Este mes"><%= usage.usd(usage.month_micros(person.id)) %></td>
              <td data-label="Mes pasado"><%= usage.usd(usage.month_micros(person.id, now: last_month)) %></td>
              <td><% unless person.id == user.id %>
                <div class="row-actions">
                  <% Frijolero::Admin::ACTIONS[person.status].each do |action, label| %>
                    <form method="post" action="/admin/users/<%= person.id %>/<%= action %>"><button type="submit"<% if action == 'resend' %> data-busy="Mandando…"<% end %>><%= label %></button></form>
                  <% end %>
                </div>
              <% end %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </main>
</body>
</html>
