<!DOCTYPE html>
<html lang="es">
<head>
  <%= head('Diario') %>
  <script src="/reports.js" defer></script>
  <script src="/editor.js" defer></script>
  <% if chart %><script src="/d3.min.js" defer></script><script src="/charts.js" defer></script><% end %>
</head>
<body>
  <%= topbar %>
  <main>
    <%= erb :_report_toolbar, layout: false, locals: { period: period, first: first, today: today } %>
    <header class="page-head">
      <hgroup>
        <h2 class="account"><%= account.empty? ? 'Todas las cuentas' : account_links(account, period) %></h2>
        <% if !error && count.positive? %><p class="net"><span class="count"><%= thousands(count) %> movimientos</span><% unless account.empty? %><% total.each do |currency, amount| %><data value="<%= amount.to_s('F') %>"><%= datum(amount) %> <%= h(currency) %></data><% end %><% end %></p><% end %>
      </hgroup>
      <% unless error %>
        <form method="get" action="/journal" role="search">
          <input type="hidden" name="account" value="<%= h(account) %>">
          <input type="hidden" name="period" value="<%= h(period.param) %>">
          <% unless mxn? %><input type="hidden" name="mxn" value="0"><% end %>
          <% unless params[:sort].to_s.empty? %><input type="hidden" name="sort" value="<%= h(params[:sort]) %>"><% end %>
          <% if options %><select name="chart" aria-label="Gráficas"><option value="">Gráficas…</option><% Frijolero::App::CHARTS.each do |name, label| %><option value="<%= name %>"<% unless options[name] %> disabled<% end %><% if chart && chart[:chart] == name %> selected<% end %>><%= label %></option><% end %></select><% end %>
          <input type="search" name="q" value="<%= h(params[:q]) %>" aria-label="Buscar" placeholder="Beneficiario o descripción">
          <button type="submit">Buscar</button>
        </form>
      <% end %>
    </header>
    <% if chart %>
      <section class="chart" aria-label="Gráfica">
        <script type="application/json" id="chart-data"><%= JSON.generate(chart).gsub('<', '\u003c') %></script>
      </section>
    <% end %>

    <% if error %>
      <p class="error" role="alert"><%= h(error) %></p>
    <% else %>
      <% if rows.empty? %>
        <% if empty %><%= erb :_empty_ledger, layout: false %><% else %><p class="note">Sin movimientos.</p><% end %>
      <% else %>
        <p class="order"><%= sort_link('date', 'Fecha', period) %><% unless account.empty? %><%= sort_link('amount', 'Monto', period) %><% end %></p>
        <ol class="ledger">
          <% rows.each do |tx| %>
            <% if tx[:balance] %>
              <% err = tx[:file] && row_error(tx[:file], tx[:line]) %>
              <li class="balance<%= ' err' if err %>">
                <time datetime="<%= h(tx[:date].iso8601) %>"><% if tx[:file] %><button type="button" class="edit" data-file="<%= h(tx[:file]) %>" data-line="<%= h(tx[:line]) %>"<% if (link = journal_statement_link(tx[:file])) %> data-statement="<%= link %>"<% end %>><%= h(tx[:date].iso8601) %></button><% else %><%= h(tx[:date].iso8601) %><% end %></time>
                <div class="entry">
                  <div><span class="status <%= err ? 'failed' : 'ok' %>">Saldo</span> <code><%= account_links(tx[:account], period) %></code></div>
                  <% if err %><p class="why"><% if (gap = balance_gap(err)) %>No cuadra: <%= h(gap) %>.<% else %><%= h(err[:code]) %> <%= h(err[:message]) %><% end %></p><% end %>
                </div>
                <% tx[:amount].each do |currency, amount| %><data value="<%= amount.to_s('F') %>"><%= datum(amount) %> <%= h(currency) %></data><% end %>
              </li>
            <% else %>
              <% link = journal_statement_link(tx[:file]) %>
              <% sum = tx[:sum] %>
              <% err = row_error(tx[:file], tx[:line]) %>
              <li class="txn<%= ' err' if err %>">
                <time datetime="<%= h(tx[:date].iso8601) %>"><button type="button" class="edit" data-file="<%= h(tx[:file]) %>" data-line="<%= h(tx[:line]) %>"<% if link %> data-statement="<%= link %>"<% end %>><%= h(tx[:date].iso8601) %></button></time>
                <details>
                  <summary>
                    <% unless sum.empty? %><span class="sum"><% sum.each do |currency, amount| %><data<% if amount.negative? %> class="debit"<% end %> value="<%= amount.to_s('F') %>"><%= datum(amount) %> <%= h(currency) %></data><% end %></span><% end %>
                    <span class="line"><% if tx[:payee] %><strong><%= h(tx[:payee]) %></strong><% unless tx[:narration].to_s.empty? %>: <% end %><% end %><%= h(tx[:narration]) %><% if tx[:flag] == '!' %> <span class="flag">!</span><% end %></span>
                    <% if err %><span class="status failed"><%= h(err[:code]) %> <%= h(err[:message]) %></span><% end %>
                  </summary>
                  <ul class="postings">
                    <% tx[:postings].each do |p| %>
                      <% currency, number = p[:amount].first %>
                      <li<% if p[:matched] %> class="matched"<% end %>><code><%= account_links(p[:account], period) %></code><data value="<%= number.to_s('F') %>"><%= datum(number) %> <%= h(currency) %></data></li>
                    <% end %>
                  </ul>
                </details>
              </li>
            <% end %>
          <% end %>
        </ol>
        <% page, pages = journal_page(count) %>
        <% if pages > 1 %>
          <nav class="pages" aria-label="Páginas">
            <% if page > 1 %><%= journal_page_link(period, page - 1, '‹ Anterior', 'prev') %><% end %>
            <span>Página <%= page %> de <%= pages %></span>
            <% if page < pages %><%= journal_page_link(period, page + 1, 'Siguiente ›', 'next') %><% end %>
          </nav>
        <% end %>
      <% end %>
    <% end %>

    <dialog id="edit">
      <h2>Editar transacción</h2>
      <p class="meta"><a class="statement"></a></p>
      <%= erb :_code, layout: false, locals: { file: '', text: '' } %>
    </dialog>
  </main>
</body>
</html>
