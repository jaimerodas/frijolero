<%
  h = ->(s) { Rack::Utils.escape_html(s.to_s) }
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <%= head('Diario') %>
</head>
<body>
  <%= topbar %>
  <main>
    <%= erb :_report_toolbar, layout: false, locals: { period: period, first: first, today: today } %>
    <p class="note"><%= account.empty? ? 'Todas las cuentas' : h.(account) %></p>

    <% if error %>
      <p class="error" role="alert"><%= h.(error) %></p>
    <% else %>
      <form method="get" action="/journal">
        <input type="hidden" name="account" value="<%= h.(account) %>">
        <input type="hidden" name="period" value="<%= h.(period.param) %>">
        <% unless mxn? %><input type="hidden" name="mxn" value="0"><% end %>
        <input type="search" name="q" value="<%= h.(params[:q]) %>" aria-label="Buscar" placeholder="Beneficiario o descripción">
        <button type="submit">Buscar</button>
      </form>

      <% if rows.empty? %>
        <p class="note">Sin movimientos.</p>
      <% else %>
        <p class="net"><%= rows.size %> movimientos<% unless account.empty? %><% total.each do |currency, amount| %><data value="<%= (amount * sign).to_s('F') %>"><%= figure(amount * sign) %> <%= h.(currency) %></data><% end %><% end %></p>
        <ol class="ledger">
          <% rows.each do |tx| %>
            <% link = journal_statement_link(tx[:file]) %>
            <% sum = Hash.new(BigDecimal('0')) %>
            <% tx[:postings].each { |p| p[:amount].each { |c, n| sum[c] += n * sign } if p[:matched] } %>
            <li class="txn">
              <time datetime="<%= h.(tx[:date].iso8601) %>"><% if link %><a href="<%= link %>"><%= h.(tx[:date].iso8601) %></a><% else %><%= h.(tx[:date].iso8601) %><% end %></time>
              <p class="line"><% if tx[:payee] %><strong><%= h.(tx[:payee]) %></strong><% unless tx[:narration].to_s.empty? %>: <% end %><% end %><%= h.(tx[:narration]) %><% if tx[:flag] == '!' %> <span class="flag">!</span><% end %></p>
              <% unless sum.empty? %><p class="sum"><% sum.each do |currency, amount| %><data<% if amount.negative? %> class="debit"<% end %> value="<%= amount.to_s('F') %>"><%= figure(amount) %> <%= h.(currency) %></data><% end %></p><% end %>
              <ul class="postings">
                <% tx[:postings].each do |p| %>
                  <% currency, number = p[:amount].first %>
                  <li<% if p[:matched] %> class="matched"<% end %>><code><%= h.(p[:account]) %></code><data value="<%= number.to_s('F') %>"><%= figure(number) %> <%= h.(currency) %></data></li>
                <% end %>
              </ul>
            </li>
          <% end %>
        </ol>
      <% end %>
    <% end %>
  </main>
</body>
</html>
