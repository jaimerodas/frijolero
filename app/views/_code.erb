<% errors = errors_in(file, 1, Float::INFINITY) %>
<form class="code" method="post" action="/edit">
  <input type="hidden" name="file" value="<%= h(file) %>">
  <input type="hidden" name="line">
  <input type="hidden" name="original">
  <script type="application/json" class="accounts"><%= JSON.generate(Frijolero::LedgerAccounts.active).gsub('<', '\u003c') %></script>
  <div class="surface"><pre><%= beancount_html(text, errors) %></pre><textarea name="content" hidden spellcheck="false" autocapitalize="off" autocorrect="off" aria-label="Beancount"></textarea></div>
  <ul class="errors error" role="alert"<% if errors.empty? %> hidden<% end %>><% errors.each do |error| %><li><%= h(error[:code]) %> <%= h(error[:message]) %> <a href="#L<%= error[:line] %>"><%= h(error[:file]) %>:<%= error[:line] %></a></li><% end %></ul>
  <p class="actions" hidden><button type="submit" class="primary">Guardar</button><button type="button" value="cancel">Cancelar</button></p>
</form>
