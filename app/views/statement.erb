<%
  h = ->(s) { Rack::Utils.escape_html(s.to_s) }
  account_path = Rack::Utils.escape_path(account)
  fixme_status = fixme_count.positive? ? 'missing' : 'received'
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <%= head("#{account} #{period_name(period)}") %>
</head>
<body>
  <%= topbar %>
  <main>
    <h1><%= h.(account) %> <%= h.(period_name(period)) %></h1>
    <p class="meta">
      <% if summary %><%= h.(summary) %> · <% end %>
      <span class="status <%= fixme_status %>"><%= fixme_count %> por clasificar</span>
    </p>

    <% if notice %>
      <p class="notice"><%= h.(notice) %></p>
    <% end %>

    <div class="actions">
      <a class="button" href="/statements/<%= account_path %>/<%= h.(period) %>/pdf">Descargar PDF</a>
      <% if rules?(account) %>
        <form method="post" action="/statements/<%= account_path %>/<%= h.(period) %>/detail">
          <button type="submit">Volver a correr las reglas</button>
        </form>
      <% end %>
    </div>

    <% if transactions.is_a?(Array) %>
      <ol class="ledger">
        <% transactions.each do |tx| %>
          <% account_name = tx['expense_account'].to_s.strip %>
          <% unclassified = account_name.empty? || account_name == 'Expenses:FIXME' %>
          <% merchant, tail = split_description(tx['description']) %>
          <li>
            <time datetime="<%= h.(tx['date']) %>"><%= h.(tx['date']) %></time>
            <div class="entry">
              <div><%= h.(merchant) %></div>
              <% if tail %><div class="tail"><%= h.(tail) %></div><% end %>
              <div class="posting">
                <% if tx['payee'] %><span><%= h.(tx['payee']) %></span><% end %>
                <% if tx['narration'] %><span class="note"><%= h.(tx['narration']) %></span><% end %>
                <% if unclassified %>
                  <span class="status missing">sin clasificar</span>
                  <form method="post" action="/rules/<%= account_path %>/from">
                    <input type="hidden" name="description" value="<%= h.(tx['description']) %>">
                    <input type="hidden" name="amount" value="<%= h.(tx['amount']) %>">
                    <button type="submit">Hacer regla</button>
                  </form>
                <% else %>
                  <code><%= h.(account_name) %></code>
                <% end %>
              </div>
            </div>
            <data value="<%= h.(tx['amount']) %>"><%= money(tx['amount']) %> <%= h.(tx['currency']) %></data>
          </li>
        <% end %>
      </ol>
    <% end %>

    <details>
      <summary>Beancount</summary>
      <pre><%= h.(beancount) %></pre>
    </details>
  </main>
</body>
</html>
