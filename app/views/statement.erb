<%
  account_path = Rack::Utils.escape_path(account)
  index = periods.index(period)
  prev_period = periods[index - 1] if index.positive?
  next_period = periods[index + 1]
  # The links carry the ledger's prefix; the hidden `back` of "Hacer regla" stays plain for back_path.
  root = ledger_path("/accounts/#{account_path}")
  base = "#{root}/#{period}"
  editing = view == :beancount
  # The arrows and the menu keep the view: from the editor they land on the editor.
  suffix = '/beancount/edit' if editing
  pending = review_rows.to_a.size
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <%= head("#{account} #{period_name(period)}") %>
  <script src="/editor.js" defer></script>
  <script src="/reports.js" defer></script>
</head>
<body>
  <%= topbar %>
  <main>
    <%= erb :_account, layout: false, locals: { account: account, tab: :statements } %>
    <%# The title is the account and the month. Its controls: Revisar while something waits, and the views. %>
    <div class="account-head">
      <h1><%= h(account) %></h1>
      <% if view == :review %>
        <%# Revisar is a mode: another month would drop what the person typed, so the month is plain text. %>
        <span class="month"><%= h(period_name(period)) %></span>
        <% if pending.positive? %>
          <div class="controls">
            <%# Its own form: a form cannot hold another, and this one saves nothing. %>
            <% if suggesting %>
              <a class="status running" href="<%= ledger_path("/jobs/#{h(suggesting.id)}") %>"><%= orbit('running') %>Sugiriendo cuentas</a>
            <% elsif can_suggest %>
              <form method="post" action="<%= base %>/suggest"><button type="submit" data-busy="Pidiendo…">Sugerir cuentas</button></form>
            <% end %>
            <%# The rules touch only the unclassified postings, which are the rows of this page. %>
            <% if File.exist?(Frijolero::Config.rules_path(account)) %><form method="post" action="<%= base %>/detail"><button type="submit">Aplicar reglas</button></form><% end %>
            <a href="<%= base %>">Cancelar</a>
          </div>
        <% end %>
      <% else %>
        <form method="get" action="<%= base %><%= suffix %>" class="period">
          <span class="month"><select name="period" aria-label="Periodo">
            <% periods.reverse_each do |option| %><option value="<%= option %>"<% if option == period %> selected<% end %>><%= h(period_name(option)) %></option><% end %>
          </select></span>
          <% if prev_period %><a href="<%= root %>/<%= prev_period %><%= suffix %>" aria-label="Anterior">&lsaquo;</a><% else %><span aria-hidden="true">&lsaquo;</span><% end %>
          <% if next_period %><a href="<%= root %>/<%= next_period %><%= suffix %>" aria-label="Siguiente">&rsaquo;</a><% else %><span aria-hidden="true">&rsaquo;</span><% end %>
        </form>
        <div class="controls">
          <%# One yellow button a page: the editor has its own Guardar, so Revisar waits there. %>
          <% if pending.positive? && !editing %><a class="button primary" href="<%= base %>/review" aria-label="Revisar, <%= pending %> sin clasificar">Revisar<span class="tally"><%= pending %></span></a><% end %>
          <nav class="toggle" aria-label="Vistas">
            <a href="<%= base %>"<% unless editing %> aria-current="true"<% end %>>Ver</a>
            <a href="<%= base %>/beancount/edit"<% if editing %> aria-current="true"<% end %>>Editar</a>
            <%# The original leaves the app, so it opens in another tab and says so. %>
            <a href="<%= base %>/pdf" target="_blank" aria-label="PDF (se abre en otra pestaña)">PDF ↗</a>
          </nav>
        </div>
      <% end %>
    </div>

    <% if notice %>
      <p class="notice"><%= h(notice) %></p>
    <% end %>

    <% if rows && view == :entries %>
      <section id="entries">
        <ol class="ledger">
          <% rows.each do |tx| %>
            <% merchant, tail = split_description(tx[:description]) %>
            <li>
              <%# The date opens the same edit dialog the journal uses, for a one-off hand edit. %>
              <time datetime="<%= h(tx[:date]) %>"><button type="button" class="edit" data-file="<%= h(file) %>" data-line="<%= tx[:line] %>"><%= h(tx[:date]) %></button></time>
              <div class="entry">
                <div><%= h(merchant) %><% if tx[:flag] == '!' %> <span class="flag">!</span><% end %></div>
                <% if tail %><div class="tail"><%= h(tail) %></div><% end %>
                <div class="posting">
                  <% if tx[:payee] %><span><%= h(tx[:payee]) %></span><% end %>
                  <% if tx[:narration] %><span class="note"><%= h(tx[:narration]) %></span><% end %>
                  <% tx[:accounts].each do |name| %>
                    <% if name == 'Expenses:FIXME' %>
                      <span class="status missing">sin clasificar</span>
                      <form method="post" action="<%= root %>/rules/from">
                        <input type="hidden" name="description" value="<%= h(tx[:description]) %>">
                        <input type="hidden" name="amount" value="<%= h(tx[:amount]&.to_s('F')) %>">
                        <input type="hidden" name="back" value="/accounts/<%= account_path %>/<%= h(period) %>">
                        <button type="submit">Hacer regla</button>
                      </form>
                    <% else %>
                      <code><%= h(name) %></code>
                    <% end %>
                  <% end %>
                </div>
              </div>
              <data class="<%= tx[:amount]&.negative? ? 'debit' : 'credit' %>" value="<%= h(tx[:amount]&.to_s('F')) %>"><%= money(tx[:amount]) %> <%= h(tx[:currency]) %></data>
            </li>
          <% end %>
        </ol>
        <% unless totals.empty? %><p class="totals"><% totals.each do |currency, sides| %><% sides.zip(%w[cargo abono], %w[debit credit]).each do |(count, sum), noun, side| %><% next if count.zero? %><span class="count"><%= thousands(count) %> <%= noun %><%= 's' unless count == 1 %></span><data class="<%= side %>" value="<%= sum.to_s('F') %>"><%= money(sum) %> <%= h(currency) %></data><% end %><% end %></p><% end %>
      </section>
      <%= erb :_edit_dialog, layout: false %>
    <% elsif rows && view == :review %>
      <% if review[:error] %><p class="error" role="alert"><%= h(review[:error]) %></p><% end %>
      <% if review_rows.empty? %>
        <p>Nada que revisar: cada movimiento tiene su cuenta. <a href="<%= base %>">Ver los movimientos</a></p>
      <% else %>
        <form method="post" action="<%= base %>/review" class="review">
          <%# The first submit button is the one Enter presses. Disabled, it makes Enter in a field do nothing: ⌘↩ saves. %>
          <button type="submit" disabled hidden></button>
          <input type="hidden" name="digest" value="<%= digest %>">
          <datalist id="review-accounts"><% accounts.each do |name| %><option value="<%= h(name) %>"><% end %></datalist>
          <datalist id="review-payees"><% payees.each do |name| %><option value="<%= h(name) %>"><% end %></datalist>
          <ol class="ledger">
            <% review_rows.each do |tx| %>
              <%
                line = tx[:line].to_s
                merchant, tail = split_description(tx[:description])
                given = review[:values][line]
                given = {} unless given.is_a?(Hash)
                error = review[:errors][line]
                guessed = guesses[Frijolero::Suggestions.key(tx)] || []
                # The first guess starts in the field, so Guardar saves it unless the person changes it.
                chosen = given.fetch('account', guessed.first)
                others = guessed - [chosen]
              %>
              <li<% if error %> class="err"<% end %>>
                <time datetime="<%= h(tx[:date]) %>"><%= h(tx[:date]) %></time>
                <div class="entry">
                  <div><%= h(merchant) %><% if tx[:flag] == '!' %> <span class="flag">!</span><% end %></div>
                  <% if tail %><div class="tail"><%= h(tail) %></div><% end %>
                  <div class="fields">
                    <input name="choice[<%= line %>][account]" value="<%= h(chosen) %>" class="account" list="review-accounts" placeholder="Cuenta" aria-label="Cuenta de <%= h(merchant) %>" autocomplete="off" spellcheck="false">
                    <input name="choice[<%= line %>][payee]" value="<%= h(given.fetch('payee', tx[:payee])) %>" list="review-payees" placeholder="Payee" aria-label="Payee de <%= h(merchant) %>">
                    <input name="choice[<%= line %>][narration]" value="<%= h(given.fetch('narration', tx[:narration])) %>" placeholder="Narración" aria-label="Narración de <%= h(merchant) %>">
                    <label><input type="checkbox" name="choice[<%= line %>][rule]" value="1" class="remember"<% if given['rule'] %> checked<% end %>> Regla</label>
                    <%# Shown only while Regla is ticked: the rule applies to every description that starts with it. %>
                    <input name="choice[<%= line %>][pattern]" value="<%= h(given['pattern'] || Frijolero::StatementReview.pattern(tx[:description])) %>" class="pattern" aria-label="La regla aplica a lo que empieza con" spellcheck="false">
                  </div>
                  <%# The guesses that the field does not hold: "Otras" says that the field holds one. %>
                  <% if others.any? %><p class="guesses"><%= others.size < guessed.size ? 'Otras:' : 'Sugeridas:' %> <% others.each do |name| %><button type="button" class="guess" data-account="<%= h(name) %>"><%= h(name) %></button><% end %></p><% end %>
                  <% if error %><span class="status failed"><%= h(error) %></span><% end %>
                </div>
                <data class="<%= tx[:amount]&.negative? ? 'debit' : 'credit' %>" value="<%= h(tx[:amount]&.to_s('F')) %>"><%= money(tx[:amount]) %> <%= h(tx[:currency]) %></data>
              </li>
            <% end %>
          </ol>
          <p class="actions"><button type="submit" class="primary" data-busy="Guardando…">Guardar</button><span class="note"><span class="keys">⌘↩ guarda. </span>Lo que dejes vacío queda sin clasificar, y las reglas de la cuenta se aplican a eso.</span></p>
        </form>
      <% end %>
    <% else %>
      <%# Editar, or the Ver of an investment statement: its summary, and the text read only. %>
      <% unless editing %><p class="net"><% if summary %><span class="count"><%= h(summary) %></span><% end %><% if fixme_count.positive? %><span class="status missing"><%= fixme_count %> sin clasificar</span><% end %></p><% end %>
      <div class="code-box"><%= erb :_code, layout: false, locals: { file: file, text: beancount, back: (base if editing) } %></div>
    <% end %>
  </main>
</body>
</html>
