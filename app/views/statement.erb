<%
  h = ->(s) { Rack::Utils.escape_html(s.to_s) }
  account_path = Rack::Utils.escape_path(account)
  fixme_status = fixme_count.positive? ? 'missing' : 'received'
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <%= head("#{account} #{period_name(period)}") %>
</head>
<body>
  <%= topbar %>
  <main>
    <h1><%= h.(account) %> <%= h.(period_name(period)) %></h1>
    <p class="meta">
      <% if summary %><%= h.(summary) %> · <% end %>
      <span class="status <%= fixme_status %>"><%= fixme_count %> por clasificar</span>
    </p>

    <% if notice %>
      <p class="notice"><%= h.(notice) %></p>
    <% end %>

    <div class="actions">
      <a class="button" href="/statements/<%= account_path %>/<%= h.(period) %>/pdf">Descargar PDF</a>
      <% if rules?(account) %>
        <form method="post" action="/statements/<%= account_path %>/<%= h.(period) %>/detail">
          <button type="submit">Volver a correr las reglas</button>
        </form>
      <% end %>
    </div>

    <% if transactions.is_a?(Array) %>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Fecha</th>
              <th>Descripción</th>
              <th>Monto</th>
              <th>Payee</th>
              <th>Narración</th>
              <th>Cuenta</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% transactions.each do |tx| %>
              <% expense_account = tx['expense_account'] %>
              <tr>
                <td class="date" data-label="Fecha"><%= h.(tx['date']) %></td>
                <td data-label="Descripción"><%= h.(tx['description']) %></td>
                <td class="amount" data-label="Monto"><%= h.(tx['amount'].nil? ? '' : format('%.2f', tx['amount'])) %> <%= h.(tx['currency']) %></td>
                <td data-label="Payee"><%= h.(tx['payee']) %></td>
                <td data-label="Narración"><%= h.(tx['narration']) %></td>
                <td data-label="Cuenta"><% unless expense_account.to_s.empty? %><code><%= h.(expense_account) %></code><% end %></td>
                <td><% if expense_account.to_s.strip.empty? || expense_account == 'Expenses:FIXME' %>
                    <form method="post" action="/rules/<%= account_path %>/from">
                      <input type="hidden" name="description" value="<%= h.(tx['description']) %>">
                      <input type="hidden" name="amount" value="<%= h.(tx['amount']) %>">
                      <button type="submit">Hacer regla</button>
                    </form>
                  <% end %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>

    <details>
      <summary>Beancount</summary>
      <pre><%= h.(beancount) %></pre>
    </details>
  </main>
</body>
</html>
