<%
  h = ->(s) { Rack::Utils.escape_html(s.to_s) }
  account_path = Rack::Utils.escape_path(account)
  prev_period, next_period = neighbours
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <%= head("#{account} #{period_name(period)}") %>
</head>
<body>
  <%= topbar %>
  <main>
    <%= erb :_cuentas, layout: false %>
    <%= erb :_account, layout: false, locals: { account: account, tab: :statements } %>
    <header class="page-head">
      <hgroup>
        <h2 class="period"><% if prev_period %><a href="/accounts/<%= account_path %>/<%= prev_period %>" aria-label="Anterior">&lsaquo;</a><% else %><span aria-hidden="true">&lsaquo;</span><% end %><%= h.(period_name(period)) %><% if next_period %><a href="/accounts/<%= account_path %>/<%= next_period %>" aria-label="Siguiente">&rsaquo;</a><% else %><span aria-hidden="true">&rsaquo;</span><% end %></h2>
        <p class="net">
          <% if rows %><span class="count"><%= thousands(rows.size) %> movimientos</span><% totals.each do |currency, sides| %><% sides.zip(%w[cargo abono], %w[debit credit]).each do |(count, sum), noun, side| %><% next if count.zero? %><span class="count"><%= thousands(count) %> <%= noun %><%= 's' unless count == 1 %></span><data class="<%= side %>" value="<%= sum.to_s('F') %>"><%= money(sum) %> <%= h.(currency) %></data><% end %><% end %><% elsif summary %><span class="count"><%= h.(summary) %></span><% end %>
          <% if fixme_count.zero? %><span class="status received">Todo clasificado</span><% else %><span class="status missing"><%= fixme_count %> sin clasificar</span><% end %>
        </p>
      </hgroup>
      <div class="actions">
        <a class="button" href="/accounts/<%= account_path %>/<%= h.(period) %>/pdf">Descargar PDF</a>
        <% if rules?(account) && fixme_count.positive? %>
          <form method="post" action="/accounts/<%= account_path %>/<%= h.(period) %>/detail">
            <button type="submit">Aplicar reglas</button>
          </form>
        <% end %>
      </div>
    </header>

    <% if notice %>
      <p class="notice"><%= h.(notice) %></p>
    <% end %>

    <% if rows %>
      <div class="tabs">
        <div class="tablist">
          <input type="radio" name="view" id="view-entries" class="visually-hidden" checked>
          <label for="view-entries">Movimientos</label>
          <input type="radio" name="view" id="view-beancount" class="visually-hidden">
          <label for="view-beancount">Beancount</label>
        </div>
        <section id="entries">
          <ol class="ledger">
            <% rows.each do |tx| %>
              <% merchant, tail = split_description(tx[:description]) %>
              <li>
                <time datetime="<%= h.(tx[:date]) %>"><%= h.(tx[:date]) %></time>
                <div class="entry">
                  <div><%= h.(merchant) %><% if tx[:flag] == '!' %> <span class="flag">!</span><% end %></div>
                  <% if tail %><div class="tail"><%= h.(tail) %></div><% end %>
                  <div class="posting">
                    <% if tx[:payee] %><span><%= h.(tx[:payee]) %></span><% end %>
                    <% if tx[:narration] %><span class="note"><%= h.(tx[:narration]) %></span><% end %>
                    <% tx[:accounts].each do |name| %>
                      <% if name == 'Expenses:FIXME' %>
                        <span class="status missing">sin clasificar</span>
                        <form method="post" action="/accounts/<%= account_path %>/rules/from">
                          <input type="hidden" name="description" value="<%= h.(tx[:description]) %>">
                          <input type="hidden" name="amount" value="<%= h.(tx[:amount]&.to_s('F')) %>">
                          <input type="hidden" name="back" value="/accounts/<%= account_path %>/<%= h.(period) %>">
                          <button type="submit">Hacer regla</button>
                        </form>
                      <% else %>
                        <code><%= h.(name) %></code>
                      <% end %>
                    <% end %>
                  </div>
                </div>
                <data class="<%= tx[:amount]&.negative? ? 'debit' : 'credit' %>" value="<%= h.(tx[:amount]&.to_s('F')) %>"><%= money(tx[:amount]) %> <%= h.(tx[:currency]) %></data>
              </li>
            <% end %>
          </ol>
        </section>
        <section id="beancount">
          <pre><%= beancount_html(beancount) %></pre>
        </section>
      </div>
    <% else %>
      <h2>Beancount</h2>
      <pre><%= beancount_html(beancount) %></pre>
    <% end %>
  </main>
</body>
</html>
