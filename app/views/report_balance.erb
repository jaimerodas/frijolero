<%
  h = ->(s) { Rack::Utils.escape_html(s.to_s) }
  net = currencies.to_h do |currency|
    [currency, %w[Assets Liabilities].sum { |root| sections.fetch(root, []).first&.dig(:amounts, currency) || 0 }]
  end
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <%= head('Balance general') %>
  <script src="/reports.js" defer></script>
</head>
<body>
  <%= topbar %>
  <main>
    <%= erb :_report_toolbar, layout: false, locals: { title: 'Balance general', period: period, first: first, today: today } %>

    <% if error %>
      <p class="error" role="alert"><%= h.(error) %></p>
    <% else %>
      <div class="columns">
        <div><%= erb :_report_table, layout: false, locals: { title: 'Activos', rows: sections.fetch('Assets', []), currencies: currencies, sign: 1 } %></div>
        <div>
          <%= erb :_report_table, layout: false, locals: { title: 'Pasivos', rows: sections.fetch('Liabilities', []), currencies: currencies, sign: -1 } %>
          <%= erb :_report_table, layout: false, locals: { title: 'Capital', rows: sections.fetch('Equity', []), currencies: currencies, sign: -1 } %>
        </div>
      </div>
      <h2>Patrimonio neto</h2>
      <p class="net"><% currencies.each do |currency| %><data value="<%= net[currency].to_s('F') %>"><%= figure(net[currency]) %> <%= h.(currency) %></data><% end %></p>
    <% end %>
  </main>
</body>
</html>
