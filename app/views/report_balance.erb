<%
  net = currencies.to_h do |currency|
    [currency, %w[Assets Liabilities].sum { |root| sections.fetch(root, []).first&.dig(:amounts, currency) || 0 }]
  end
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <%= head('Balance general') %>
  <script src="/reports.js" defer></script>
  <% if chart %><script src="/d3.min.js" defer></script><script src="/charts.js" defer></script><% end %>
</head>
<body>
  <%= topbar %>
  <main>
    <%= erb :_report_toolbar, layout: false, locals: { period: period, first: first, today: today } %>

    <% if error %>
      <p class="error" role="alert"><%= h(error) %></p>
    <% else %>
      <% if empty %><%= erb :_empty_ledger, layout: false %><% end %>
      <% if chart %>
        <section class="chart icicle" aria-label="Gráfica">
          <script type="application/json" id="chart-data"><%= JSON.generate(chart).gsub('<', '<') %></script>
        </section>
      <% end %>
      <div class="tables<%= ' behind' if chart %>">
      <div class="columns">
        <div><%= erb :_report_table, layout: false, locals: { title: 'Activos', rows: sections.fetch('Assets', []), currencies: currencies, sign: 1, period: period } %></div>
        <div>
          <%= erb :_report_table, layout: false, locals: { title: 'Pasivos', rows: sections.fetch('Liabilities', []), currencies: currencies, sign: -1, period: period } %>
          <%= erb :_report_table, layout: false, locals: { title: 'Capital', rows: sections.fetch('Equity', []), currencies: currencies, sign: -1, period: period } %>
        </div>
      </div>
      <%= erb :_closing, layout: false, locals: { title: 'Patrimonio neto', currencies: currencies, net: net } %>
      </div>
    <% end %>
  </main>
</body>
</html>
