<% glyph, word = Frijolero::Admin::STATUS[person.status] %>
<!DOCTYPE html>
<html lang="es">
<head>
  <%= head(person.name || person.email) %>
  <script src="/reports.js" defer></script>
</head>
<body>
  <%= bar %>
  <main>
    <h1><%= h(person.name || person.email) %></h1>
    <p class="meta"><% if person.name %><%= h(person.email) %> · <% end %><span class="status <%= glyph %>"><%= word %></span></p>
    <% if notice %>
      <p class="notice" role="status"><%= h(notice) %></p>
    <% end %>
    <% if error %>
      <p class="error" role="alert"><%= h(error) %></p>
    <% end %>

    <% unless person.id == user.id %>
      <div class="actions">
        <% Frijolero::Admin::ACTIONS[person.status].each do |action, label| %>
          <form method="post" action="/admin/users/<%= person.id %>/<%= action %>">
            <input type="hidden" name="from" value="person">
            <button type="submit"<% if action == 'resend' %> data-busy="Mandando…"<% end %>><%= label %></button>
          </form>
        <% end %>
        <% if person.status == 'active' %>
          <span class="note">Para borrar a esta persona, primero bloquéala.</span>
        <% else %>
          <a class="button" href="/admin/users/<%= person.id %>/delete">Borrar usuario…</a>
        <% end %>
      </div>
    <% end %>

    <h2>Ledgers</h2>
    <%= erb :_person_ledgers, layout: false, locals: { ledgers: Frijolero::Ledger.owned_by(person.id) } %>

    <h2>Uso del modelo</h2>
    <%= erb :_usage, layout: false, locals: { person: person } %>
  </main>
</body>
</html>
