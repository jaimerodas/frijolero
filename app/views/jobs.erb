<%
  h = ->(s) { Rack::Utils.escape_html(s.to_s) }
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <%= head %>
</head>
<body>
  <%= topbar %>
  <main>
    <h1>Jobs</h1>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Etiqueta</th>
            <th>Estado</th>
            <th>Inicio</th>
            <th>Fin</th>
          </tr>
        </thead>
        <tbody>
          <% jobs.each do |job| %>
            <tr>
              <th scope="row"><a href="/jobs/<%= h.(job.id) %>"><%= h.(job.label) %></a></th>
              <td data-label="Estado"><span class="status <%= h.(job.status) %>"><%= h.(job.status) %></span></td>
              <td class="date" data-label="Inicio"><%= h.(job.started_at) %></td>
              <td class="date" data-label="Fin"><%= h.(job.finished_at) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </main>
</body>
</html>
