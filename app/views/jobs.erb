<!DOCTYPE html>
<html lang="es">
<head>
  <%= head('Bitácora') %>
</head>
<body>
  <%= topbar %>
  <main>
    <%= erb :_cuentas, layout: false %>
    <% if jobs.empty? %>
    <p>Todavía no hay corridas. Una corrida se crea cuando subes un estado de cuenta.</p>
    <% else %>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Etiqueta</th>
            <th>Estado</th>
            <th>Inicio</th>
            <th>Fin</th>
          </tr>
        </thead>
        <tbody>
          <% jobs.each do |job| %>
            <tr>
              <th scope="row"><a href="/jobs/<%= h(job.id) %>"><%= h(job.label) %></a></th>
              <td data-label="Estado"><span class="status <%= h(job.status) %>"><%= job_status(job.status) %></span></td>
              <td class="date" data-label="Inicio"><%= h(local_time(job.started_at)) %></td>
              <td class="date" data-label="Fin"><%= h(local_time(job.finished_at)) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <% end %>
  </main>
</body>
</html>
