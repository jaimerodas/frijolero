<%
  # Only Default and Multi have rules: the banks and the cards. The other pipelines are investments.
  banks, investments = open.partition { |key, _config| rules?(key) }
  groups = [['Bancos y tarjetas', banks, true], ['Inversiones', investments, false]].reject { |_, accounts, _| accounts.empty? }
  # LedgerFiles walks from the main file, so it comes first, and rledger reads each other file through it.
  main_file, *included = other_ledger_files
  account_path = ->(key) { ledger_path("/accounts/#{Rack::Utils.escape_path(key)}") }
  file_path = ->(file) { ledger_path("/files/#{Rack::Utils.escape_path(file)}") }
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <%= head('Cuentas') %>
</head>
<body>
  <%= topbar %>
  <main>
    <%= erb :_cuentas, layout: false %>

    <%# A page for setup: the settings pages of each account, and the files to edit. The state of
        the statements is on Recientes, so nothing here is about statements. %>
    <div class="setup">
      <section>
        <% if open.empty? && closed.empty? %>
          <%# The header has the button to the form. %>
          <p>No hay cuentas.</p>
        <% else %>
          <% groups.each do |title, accounts, rules| %>
            <h2><%= title %></h2>
            <ul class="tiles">
              <% accounts.each do |key, config| %>
                <% base = account_path.(key) %>
                <li class="tile">
                  <div>
                    <a class="name" href="<%= base %>"><%= h(key) %></a>
                    <% unless config['description'].to_s.strip.empty? %><p><%= h(config['description']) %></p><% end %>
                  </div>
                  <div class="tile-actions">
                    <a href="<%= base %>/config" aria-label="Configuración de <%= h(key) %>">Configuración</a>
                    <% if rules %><a href="<%= base %>/rules" aria-label="Reglas de <%= h(key) %>">Reglas</a><% end %>
                  </div>
                </li>
              <% end %>
            </ul>
          <% end %>
          <% unless closed.empty? %>
            <p class="closed">Cerradas:
              <% closed.each_key.with_index do |key, i| %><%= ', ' if i.positive? %><a href="<%= account_path.(key) %>"><%= h(key) %></a><% end %>
            </p>
          <% end %>
          <p class="actions"><a class="button" href="<%= ledger_path('/accounts/new') %>">Nueva cuenta</a></p>
        <% end %>
      </section>

      <section>
        <h2>Archivos</h2>
        <ul class="file-tree files">
          <% if main_file %>
            <li>
              <a href="<%= file_path.(main_file) %>"><code><%= h(main_file) %></code></a> <span class="note">principal</span>
              <% unless included.empty? %>
                <ul>
                  <% included.each do |file| %>
                    <li><a href="<%= file_path.(file) %>"><code><%= h(file) %></code></a></li>
                  <% end %>
                </ul>
              <% end %>
            </li>
          <% end %>
          <li><a href="<%= ledger_path('/accounts/yaml') %>"><code>accounts.yaml</code></a> <span class="note">todas las cuentas</span></li>
        </ul>
      </section>
    </div>
  </main>
</body>
</html>
