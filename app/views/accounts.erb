<%
  h = ->(s) { Rack::Utils.escape_html(s.to_s) }
  sections = [['Activas', open], ['Cerradas', closed]].reject { |_title, accounts| accounts.empty? }
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <%= head('Cuentas') %>
</head>
<body>
  <%= topbar %>
  <main>
    <h1>Cuentas</h1>

    <% sections.each do |title, accounts| %>
      <h2><%= title %></h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Cuenta</th>
              <th>Beancount</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% accounts.each do |key, config| %>
              <% path = Rack::Utils.escape_path(key) %>
              <tr>
                <th scope="row"><a href="/statements/<%= path %>"><%= h.(key) %></a></th>
                <td data-label="Beancount"><code><%= h.(config['beancount_account']) %></code></td>
                <td>
                  <a class="button" href="/statements/<%= path %>">Estados</a>
                  <a class="button" href="/accounts/<%= path %>/config">Configuración</a>
                  <% if rules?(key) %><a class="button" href="/rules/<%= path %>">Reglas</a><% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>

    <p class="actions"><a class="button primary" href="/accounts/new">Nueva cuenta</a></p>
    <p><a href="/accounts/yaml">Editar el archivo completo</a></p>
  </main>
</body>
</html>
