<%
  sections = [['Activas', open], ['Cerradas', closed]].reject { |_title, accounts| accounts.empty? }
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <%= head('Cuentas') %>
</head>
<body>
  <%= topbar %>
  <main>
    <%= erb :_cuentas, layout: false %>

    <% if sections.empty? %>
      <p>No hay cuentas.</p>
    <% end %>
    <% sections.each do |title, accounts| %>
      <h2><%= title %></h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Cuenta</th>
              <th>Beancount</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% accounts.each do |key, config| %>
              <% path = Rack::Utils.escape_path(key) %>
              <tr>
                <th scope="row"><a href="/accounts/<%= path %>"><%= h(key) %></a></th>
                <td data-label="Beancount"><code><%= h(config['beancount_account']) %></code></td>
                <td>
                  <a class="button" href="/accounts/<%= path %>">Estados</a>
                  <a class="button" href="/accounts/<%= path %>/config">Configuración</a>
                  <% if rules?(key) %><a class="button" href="/accounts/<%= path %>/rules">Reglas</a><% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>

    <p class="actions"><a class="button primary" href="/accounts/new">Nueva cuenta</a></p>
    <p><a href="/accounts/yaml">Editar el archivo completo</a></p>

    <% unless (files = other_ledger_files).empty? %>
      <h2>Otros archivos beancount</h2>
      <ul class="files">
        <% files.each do |file| %>
          <li><a href="/files/<%= Rack::Utils.escape_path(file) %>"><code><%= h(file) %></code></a></li>
        <% end %>
      </ul>
    <% end %>
  </main>
</body>
</html>
