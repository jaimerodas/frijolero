<!DOCTYPE html>
<html lang="es">
<head>
  <%= erb :_head, layout: false, locals: { title: 'Entrar', refresh: nil } %>
</head>
<body class="login">
  <main>
    <h1 class="wordmark">Frijolero</h1>
    <p class="tagline">Mis finanzas personales.</p>
    <% if error %>
      <p class="error" role="alert">Contraseña incorrecta.</p>
    <% end %>
    <form method="post" action="/login">
      <label for="password">Contraseña</label>
      <div class="row">
        <input id="password" type="password" name="password" autocomplete="current-password" autofocus required>
        <button type="submit" class="primary">Entrar</button>
      </div>
    </form>
  </main>
</body>
</html>
