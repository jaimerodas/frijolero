<!DOCTYPE html>
<html lang="es">
<head>
  <%= erb :_head, layout: false, locals: { title: 'Entrar', refresh: nil } %>
  <script src="/passkeys.js" defer></script>
</head>
<body class="login">
  <main>
    <h1 class="wordmark">Frijolero</h1>
    <p class="tagline">Mis finanzas personales.</p>
    <% if notice %>
      <p class="notice" role="status"><%= notice %></p>
    <% end %>
    <% if error %>
      <p class="error" role="alert"><%= error %></p>
    <% end %>
    <% if link %>
      <%# No action: the form posts to the URL of the link, so the token is never echoed. %>
      <form method="post">
        <button type="submit" class="primary" autofocus>Entrar</button>
      </form>
    <% else %>
      <form method="post" action="/login">
        <label for="email">Correo</label>
        <div class="row">
          <input id="email" type="email" name="email" autocomplete="email webauthn" autofocus required>
          <button type="submit" class="primary">Mandar enlace</button>
        </div>
      </form>
      <%# The autofill of the email field offers the passkeys of the site. When the person
          picks one, public/passkeys.js puts the answer in credential and posts this form. %>
      <form method="post" action="/login/passkey" id="passkey-signin" data-options="/login/challenge" hidden>
        <input type="hidden" name="credential">
      </form>
    <% end %>
  </main>
</body>
</html>
