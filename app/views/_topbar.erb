<header class="topbar">
  <a class="brand" href="/">Frijolero</a>
  <nav aria-label="Secciones">
    <% { '/upload' => 'Subir', '/jobs' => 'Jobs', '/accounts' => 'Cuentas', '/reports' => 'Reportes' }.each do |href, label| %>
      <a href="<%= href %>"<% if request&.path_info.to_s.start_with?(href) %> aria-current="page"<% end %>><%= label %></a>
    <% end %>
  </nav>
  <form method="post" action="/logout"><button type="submit">Salir</button></form>
</header>
