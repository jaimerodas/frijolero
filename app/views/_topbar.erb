<%
  path = request&.path_info.to_s
  sections = { 'Cuentas' => %w[/ /upload /jobs /accounts], 'Reportes' => %w[/reports /journal] }
%>
<header class="topbar">
  <a class="brand" href="/">Frijolero</a>
  <nav aria-label="Secciones">
    <% sections.each do |label, prefixes| %>
      <a href="<%= prefixes.first %>"<% if prefixes.any? { |p| path == p || path.start_with?("#{p}/") } %> aria-current="page"<% end %>><%= label %></a>
    <% end %>
  </nav>
  <form method="post" action="/logout"><button type="submit">Salir</button></form>
</header>
