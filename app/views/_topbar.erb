<%
  path = request&.path_info.to_s
  sections = { 'Estados de cuenta' => %w[/ /upload /inbox /jobs /accounts], 'Reportes' => %w[/reports /journal] }
  errors = ledger_errors
  # Login's user; a test that calls App directly has none.
  user = request.env['frijolero.user']
  current = Frijolero::Ledger.current
  ledgers = user ? Frijolero::Ledger.owned_by(user.id) : []
%>
<header class="topbar">
  <%# The error badge beside the wordmark: the errors are of the ledger it names, and on a
      phone the sections and Opciones keep their own line. %>
  <div class="brand-row">
    <a class="brand" href="<%= ledger_path('/') %>"><%= h(Frijolero::Config.title) %></a>
    <% if errors && !errors.empty? %>
      <% label = errors.size == 1 ? '1 error' : "#{errors.size} errores" %>
      <a class="errors" href="<%= ledger_path('/errors') %>" aria-label="<%= label %>" title="<%= label %>"<% if path == '/errors' %> aria-current="page"<% end %>><span><%= errors.size %></span></a>
    <% end %>
  </div>
  <nav aria-label="Secciones">
    <% sections.each do |label, prefixes| %>
      <a href="<%= ledger_path(prefixes.first) %>"<% if prefixes.any? { |p| path == p || path.start_with?("#{p}/") } %> aria-current="page"<% end %>><%= label %></a>
    <% end %>
  </nav>
  <%# The menu: the switch to the other ledgers, the settings, a new ledger, Salir. A generic
      name, because the wordmark already names the ledger and a name can be long. %>
  <details class="menu">
    <summary>Opciones</summary>
    <nav aria-label="Opciones">
      <% if ledgers.size > 1 %>
        <ul>
          <% ledgers.each do |ledger| %>
            <%# An own repo that is not connected yet has no pages: its link finishes it. %>
            <% href = File.directory?(ledger.repo_dir) ? "/l/#{ledger.id}/" : "/ledgers/#{ledger.id}/connect" %>
            <li><a href="<%= href %>"<% if ledger.id == current.id %> aria-current="true"<% end %>><%= h(ledger.name) %></a></li>
          <% end %>
        </ul>
      <% end %>
      <ul>
        <li><a href="<%= ledger_path('/ledger') %>"<% if path == '/ledger' %> aria-current="page"<% end %>>Configuración</a></li>
        <li><a href="/ledgers/new">Nuevo ledger</a></li>
        <li><a href="/passkeys">Llaves de acceso</a></li>
        <% if user&.admin? %><li><a href="/admin">Usuarios</a></li><% end %>
      </ul>
      <ul>
        <li><form method="post" action="/logout"><button type="submit">Salir</button></form></li>
      </ul>
    </nav>
  </details>
</header>
