<%
  h = ->(s) { Rack::Utils.escape_html(s.to_s) }
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <%= head(title) %>
</head>
<body>
  <h1><%= h.(title) %></h1>
  <nav>
    <a href="<%= h.(back) %>">Volver</a>
    <a href="/accounts">Cuentas</a>
  </nav>
  <% if notice %>
    <p class="notice"><%= h.(notice) %></p>
  <% end %>
  <% if error %>
    <p class="error" role="alert"><%= h.(error) %></p>
  <% end %>
  <form method="post" action="<%= h.(action) %>">
    <textarea name="content" rows="30" spellcheck="false" style="width:100%;font-family:ui-monospace,monospace"><%= h.(content) %></textarea>
    <p><button type="submit">Guardar</button></p>
  </form>
</body>
</html>
