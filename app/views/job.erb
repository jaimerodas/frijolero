<%
  h = ->(s) { Rack::Utils.escape_html(s.to_s) }
  account, _, period = job.label.rpartition(' ')
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <%= head(refresh: job.done? ? nil : 3) %>
</head>
<body>
  <h1><%= h.(job.label) %></h1>
  <p>Estado: <%= h.(job.status) %></p>

  <% if job.error %>
    <p class="error"><%= h.(job.error) %></p>
  <% end %>

  <% if job.status == 'ok' %>
    <p><a href="/statements/<%= Rack::Utils.escape_path(account) %>/<%= h.(period) %>">Ver estado de cuenta</a></p>
  <% end %>

  <pre><%= h.(job.output) %></pre>

  <p><a href="/jobs">Jobs</a> · <a href="/">Regresar</a></p>
</body>
</html>
