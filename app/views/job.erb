<%
  h = ->(s) { Rack::Utils.escape_html(s.to_s) }
  account, _, period = job.label.rpartition(' ')
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <%= head(refresh: job.done? ? nil : 3) %>
</head>
<body>
  <%= topbar %>
  <main>
    <h1><%= h.(job.label) %></h1>
    <p class="meta"><span class="status <%= h.(job.status) %>"><%= h.(job.status) %></span></p>

    <% if job.error %>
      <p class="error" role="alert"><%= h.(job.error) %></p>
    <% end %>

    <% if job.status == 'ok' %>
      <p class="actions"><a class="button" href="/statements/<%= Rack::Utils.escape_path(account) %>/<%= h.(period) %>">Ver estado de cuenta</a></p>
    <% end %>

    <pre><%= h.(job.output) %></pre>
  </main>
</body>
</html>
