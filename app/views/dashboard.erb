<%
  h = ->(s) { Rack::Utils.escape_html(s.to_s) }
  labels = { received: 'recibido', missing: 'falta', pending: 'pendiente', failed: 'falló' }
  periods = dashboard.periods
  cutoff = ->(day) { day.nil? ? '' : (day == 31 ? 'fin de mes' : "día #{day}") }
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <%= head %>
</head>
<body>
  <%= topbar %>
  <main>
    <h1>Últimos periodos</h1>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Cuenta</th>
            <th>Corte</th>
            <% periods.each do |period| %>
              <th><%= h.(period_name(period)) %></th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% dashboard.rows.each do |row| %>
            <% path = Rack::Utils.escape_path(row.account) %>
            <tr>
              <th scope="row"><a href="/accounts/<%= path %>"><%= h.(row.account) %></a><% if rules?(row.account) %> <a class="rules" href="/rules/<%= path %>" title="Reglas de <%= h.(row.account) %>">reglas</a><% end %></th>
              <td class="cutoff" data-label="Corte"><%= h.(cutoff.(row.cutoff_day)) %></td>
              <% periods.each do |period| %>
                <% status = row.statuses[period] %>
                <td data-label="<%= h.(period_name(period)) %>">
                  <% if status == :received %>
                    <a class="status received" href="/statements/<%= path %>/<%= period %>"><%= labels[status] %></a>
                  <% else %>
                    <span class="status <%= status %>"><%= labels[status] %></span>
                  <% end %>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </main>
</body>
</html>
