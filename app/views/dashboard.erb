<%
  periods = dashboard.periods
  cutoff = ->(day) { day.nil? ? '' : (day == 31 ? 'fin de mes' : "día #{day}") }
  # '3 oct', as in the job times.
  closes = ->(date) { "cierra el #{date.day} #{Frijolero::Period::MONTHS[date.month - 1][0, 3]}" }
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <%= head %>
</head>
<body>
  <%= topbar %>
  <main>
    <%= erb :_cuentas, layout: false %>
    <% if waiting.positive? %>
    <p><a class="status missing" href="<%= ledger_path('/inbox') %>"><%= waiting %> por confirmar</a></p>
    <% end %>
    <% if dashboard.rows.empty? %>
    <p>No hay cuentas. <a href="<%= ledger_path('/accounts/new') %>">Da de alta la primera.</a></p>
    <% else %>
    <div class="table-wrap">
      <table class="recent">
        <thead>
          <tr>
            <th>Cuenta</th>
            <th>Corte</th>
            <% periods.each do |period| %>
              <th><%= h(period_name(period)) %></th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% dashboard.rows.each do |row| %>
            <% base = ledger_path("/accounts/#{Rack::Utils.escape_path(row.account)}") %>
            <tr>
              <th scope="row"><a href="<%= base %>"><%= h(row.account) %></a></th>
              <td class="cutoff" data-label="Corte"><%= h(cutoff.(row.cutoff_day)) %></td>
              <% periods.each do |period| %>
                <% status = row.statuses[period] %>
                <td data-label="<%= h(period_name(period)) %>">
                  <% if status == :received %>
                    <a class="status received" href="<%= base %>/<%= period %>">listo</a>
                  <% elsif status == :review %>
                    <%# Revisar takes these rows. An investment has no Revisar: its statement says what to fix. %>
                    <a class="status missing" href="<%= base %>/<%= period %><%= '/review' if rules?(row.account) %>"><%= row.unclassified[period] %> por revisar</a>
                  <% elsif status == :missing %>
                    <a class="status missing" href="<%= ledger_path('/upload') %>">falta</a>
                  <% elsif status == :failed %>
                    <a class="status failed" href="<%= ledger_path("/jobs/#{h(dashboard.failed_job_id(row.account, period))}") %>">falló</a>
                  <% else %>
                    <span class="status pending"><%= closes.(Frijolero::Dashboard.closing(period, row.cutoff_day)) %></span>
                  <% end %>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <% end %>
    <p class="note"><small>Uso del mes: <%= h(month_usage) %></small></p>
  </main>
</body>
</html>
