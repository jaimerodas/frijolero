<div class="title">
  <nav aria-label="Estados de cuenta">
    <% path = request&.path_info.to_s %>
    <%# A page under Cuentas or Bitácora has its own h1, so the name stays a link, marked current. %>
    <% { '/' => 'Recientes', '/accounts' => 'Cuentas', '/jobs' => 'Bitácora' }.each do |href, label| %>
      <% if path == href %><h1><%= label %></h1><% else %><a href="<%= href %>"<% if href != '/' && path.start_with?("#{href}/") %> aria-current="true"<% end %>><%= label %></a><% end %>
    <% end %>
  </nav>
  <%# Without an account there is nothing to upload to, so the one button is the first account, in ink. %>
  <% if Frijolero::Config.accounts.empty? %>
    <% unless request&.path_info == '/accounts/new' %><a class="button primary ink" href="/accounts/new">Dar de alta una cuenta</a><% end %>
  <% else %>
    <% unless request&.path_info == '/upload' %><a class="button primary" href="/upload">Subir estado de cuenta</a><% end %>
  <% end %>
</div>
