<div class="title">
  <nav aria-label="Estados de cuenta">
    <% { '/' => 'Recientes', '/accounts' => 'Cuentas', '/jobs' => 'Bitácora' }.each do |href, label| %>
      <% if request&.path_info == href %><h1><%= label %></h1><% else %><a href="<%= href %>"><%= label %></a><% end %>
    <% end %>
  </nav>
  <%# Without an account there is nothing to upload to, so the one button is the first account, in red. %>
  <% if Frijolero::Config.accounts.empty? %>
    <% unless request&.path_info == '/accounts/new' %><a class="button primary red" href="/accounts/new">Dar de alta una cuenta</a><% end %>
  <% else %>
    <% unless request&.path_info == '/upload' %><a class="button primary" href="/upload">Subir estado de cuenta</a><% end %>
  <% end %>
</div>
