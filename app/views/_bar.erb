<%# The header of the pages outside a ledger (Page). The wordmark goes to /, which lists the user's ledgers. %>
<header class="topbar">
  <a class="brand" href="/">Frijolero</a>
  <nav aria-label="Secciones">
    <a href="/profile"<% if %w[/profile /passkeys].include?(request.path_info) %> aria-current="page"<% end %>>Mi cuenta</a>
    <% if user.admin? %><a href="/admin"<% if request.path_info.start_with?('/admin') %> aria-current="page"<% end %>>Usuarios</a><% end %>
  </nav>
  <form method="post" action="/logout"><button type="submit">Salir</button></form>
</header>
