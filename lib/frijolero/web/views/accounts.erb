<%
  h = ->(s) { Rack::Utils.escape_html(s.to_s) }
  sections = [['Activas', open], ['Cerradas', closed]].reject { |_title, accounts| accounts.empty? }
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <%= head('Cuentas') %>
</head>
<body>
  <h1>Cuentas</h1>
  <nav>
    <a href="/">Volver</a>
  </nav>

  <% sections.each do |title, accounts| %>
    <h2><%= title %></h2>
    <table>
      <tr>
        <th>Cuenta</th>
        <th>Beancount</th>
        <th></th>
      </tr>
      <% accounts.each do |key, config| %>
        <% path = Rack::Utils.escape_path(key) %>
        <tr>
          <td><%= h.(key) %></td>
          <td><%= h.(config['beancount_account']) %></td>
          <td>
            <a href="/accounts/<%= path %>">estados</a> ·
            <a href="/accounts/<%= path %>/config">config</a> ·
            <a href="/rules/<%= path %>">reglas</a>
          </td>
        </tr>
      <% end %>
    </table>
  <% end %>

  <p><a href="/accounts/yaml">Editar archivo completo</a></p>
</body>
</html>
