<%
  h = ->(s) { Rack::Utils.escape_html(s.to_s) }
  sections = [['Activas', open], ['Cerradas', closed]].reject { |_title, accounts| accounts.empty? }
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Cuentas</title>
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; margin: 2rem; }
    nav a { margin-right: 1rem; }
    table { border-collapse: collapse; margin-bottom: 2rem; }
    th, td { padding: 0.5rem 1rem; text-align: left; border-bottom: 1px solid #ddd; }
  </style>
</head>
<body>
  <h1>Cuentas</h1>
  <nav>
    <a href="/">Volver</a>
  </nav>

  <% sections.each do |title, accounts| %>
    <h2><%= title %></h2>
    <table>
      <tr>
        <th>Cuenta</th>
        <th>Beancount</th>
        <th></th>
      </tr>
      <% accounts.each do |key, config| %>
        <% path = Rack::Utils.escape_path(key) %>
        <tr>
          <td><%= h.(key) %></td>
          <td><%= h.(config['beancount_account']) %></td>
          <td>
            <a href="/accounts/<%= path %>">estados</a> ·
            <a href="/accounts/<%= path %>/config">config</a> ·
            <a href="/rules/<%= path %>">reglas</a>
          </td>
        </tr>
      <% end %>
    </table>
  <% end %>

  <p><a href="/accounts/yaml">Editar archivo completo</a></p>
</body>
</html>
