<%
  h = ->(s) { Rack::Utils.escape_html(s.to_s) }
  account_path = Rack::Utils.escape_path(account)
  fixme_status = fixme_count.positive? ? 'missing' : 'received'
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= h.(account) %> <%= h.(period) %></title>
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; margin: 2rem; }
    table { border-collapse: collapse; width: 100%; }
    th, td { padding: 0.5rem 1rem; text-align: left; border-bottom: 1px solid #ddd; }
    td.amount { text-align: right; font-variant-numeric: tabular-nums; }
    .status.missing { color: #b00020; }
    .status.received { color: #1b7f3b; }
    .notice { background: #eef6ff; padding: .5rem 1rem; }
    .table-wrap { overflow-x: auto; }
    pre { overflow-x: auto; background: #f5f5f5; padding: 1rem; }
  </style>
</head>
<body>
  <h1><%= h.(account) %> <%= h.(period) %></h1>
  <p>
    <a href="/">Regresar</a> ·
    <a href="/statements/<%= account_path %>/<%= h.(period) %>/pdf">Descargar PDF</a>
  </p>

  <% if notice %>
    <p class="notice"><%= h.(notice) %></p>
  <% end %>

  <p>
    <% if summary %>
      <%= h.(summary) %> ·
    <% end %>
    <span class="status <%= fixme_status %>"><%= fixme_count %> por clasificar</span>
  </p>

  <form method="post" action="/statements/<%= account_path %>/<%= h.(period) %>/detail">
    <button type="submit">Volver a correr las reglas</button>
  </form>

  <% if transactions.is_a?(Array) %>
    <div class="table-wrap">
      <table>
        <tr>
          <th>Fecha</th>
          <th>Descripción</th>
          <th>Monto</th>
          <th>Payee</th>
          <th>Narración</th>
          <th>Cuenta</th>
          <th></th>
        </tr>
        <% transactions.each do |tx| %>
          <% expense_account = tx['expense_account'] %>
          <tr>
            <td><%= h.(tx['date']) %></td>
            <td><%= h.(tx['description']) %></td>
            <td class="amount"><%= h.(format('%.2f', tx['amount'])) %> <%= h.(tx['currency']) %></td>
            <td><%= h.(tx['payee']) %></td>
            <td><%= h.(tx['narration']) %></td>
            <td><%= h.(expense_account) %></td>
            <td>
              <% if expense_account.to_s.strip.empty? || expense_account == 'Expenses:FIXME' %>
                <form method="post" action="/rules/<%= account_path %>/from">
                  <input type="hidden" name="description" value="<%= h.(tx['description']) %>">
                  <input type="hidden" name="amount" value="<%= h.(tx['amount']) %>">
                  <button type="submit">Hacer regla</button>
                </form>
              <% end %>
            </td>
          </tr>
        <% end %>
      </table>
    </div>
  <% end %>

  <details>
    <summary>Beancount</summary>
    <pre><%= h.(beancount) %></pre>
  </details>
</body>
</html>
