<%
  h = ->(s) { Rack::Utils.escape_html(s.to_s) }
  labels = { received: 'recibido', missing: 'falta', pending: 'pendiente', failed: 'falló' }
  periods = dashboard.periods
  cutoff = ->(day) { day.nil? ? '' : (day == 31 ? 'fin de mes' : "día #{day}") }
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <%= head %>
</head>
<body>
  <h1>Frijolero</h1>
  <p><a href="/upload">Subir estado de cuenta</a> · <a href="/jobs">Jobs</a> · <a href="/accounts">Cuentas</a></p>
  <table>
    <tr>
      <th>Cuenta</th>
      <th>Corte</th>
      <% periods.each do |period| %>
        <th><%= h.(period) %></th>
      <% end %>
    </tr>
    <% dashboard.rows.each do |row| %>
      <tr>
        <td><a href="/accounts/<%= Rack::Utils.escape_path(row.account) %>"><%= h.(row.account) %></a> <a class="rules" href="/rules/<%= Rack::Utils.escape_path(row.account) %>" title="Reglas de <%= h.(row.account) %>">reglas</a></td>
        <td class="cutoff"><%= h.(cutoff.(row.cutoff_day)) %></td>
        <% periods.each do |period| %>
          <% status = row.statuses[period] %>
          <td>
            <span class="status <%= status %>">
              <% if status == :received %>
                <a href="/statements/<%= Rack::Utils.escape_path(row.account) %>/<%= period %>"><%= labels[status] %></a>
              <% else %>
                <%= labels[status] %>
              <% end %>
            </span>
          </td>
        <% end %>
      </tr>
    <% end %>
  </table>
</body>
</html>
