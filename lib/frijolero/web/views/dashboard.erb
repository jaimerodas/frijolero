<%
  h = ->(s) { Rack::Utils.escape_html(s.to_s) }
  labels = { received: 'recibido', missing: 'falta', pending: 'pendiente', failed: 'falló' }
  periods = dashboard.periods
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <title>Frijolero</title>
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; margin: 2rem; }
    table { border-collapse: collapse; }
    th, td { padding: 0.5rem 1rem; text-align: left; border-bottom: 1px solid #ddd; }
    .status.missing { color: #b00020; }
    .status.failed { color: #b00020; font-weight: 600; }
    .status.received { color: #1b7f3b; }
    .status.pending { color: #666; }
  </style>
</head>
<body>
  <h1>Frijolero</h1>
  <p><a href="/upload">Subir estado de cuenta</a></p>
  <table>
    <tr>
      <th>Cuenta</th>
      <% periods.each do |period| %>
        <th><%= h.(period) %></th>
      <% end %>
    </tr>
    <% dashboard.rows.each do |row| %>
      <tr>
        <td><%= h.(row.account) %></td>
        <% periods.each do |period| %>
          <% status = row.statuses[period] %>
          <td>
            <span class="status <%= status %>">
              <% if status == :received %>
                <a href="/statements/<%= Rack::Utils.escape_path(row.account) %>/<%= period %>"><%= labels[status] %></a>
              <% else %>
                <%= labels[status] %>
              <% end %>
            </span>
          </td>
        <% end %>
      </tr>
    <% end %>
  </table>
</body>
</html>
