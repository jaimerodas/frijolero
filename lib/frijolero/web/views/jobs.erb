<%
  h = ->(s) { Rack::Utils.escape_html(s.to_s) }
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <%= head %>
</head>
<body>
  <h1>Jobs</h1>
  <table>
    <tr>
      <th>Etiqueta</th>
      <th>Estado</th>
      <th>Inicio</th>
      <th>Fin</th>
    </tr>
    <% jobs.each do |job| %>
      <tr>
        <td><a href="/jobs/<%= h.(job.id) %>"><%= h.(job.label) %></a></td>
        <td><%= h.(job.status) %></td>
        <td><%= h.(job.started_at) %></td>
        <td><%= h.(job.finished_at) %></td>
      </tr>
    <% end %>
  </table>
  <p><a href="/">Regresar</a></p>
</body>
</html>
