<%
  h = ->(s) { Rack::Utils.escape_html(s.to_s) }
  account, _, period = job.label.rpartition(' ')
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <title>Frijolero</title>
  <% unless job.done? %>
    <meta http-equiv="refresh" content="3">
  <% end %>
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; margin: 2rem; }
    pre { background: #f5f5f5; padding: 1rem; overflow-x: auto; white-space: pre-wrap; }
    .error { color: #b00020; }
  </style>
</head>
<body>
  <h1><%= h.(job.label) %></h1>
  <p>Estado: <%= h.(job.status) %></p>

  <% if job.error %>
    <p class="error"><%= h.(job.error) %></p>
  <% end %>

  <% if job.status == 'ok' %>
    <p><a href="/statements/<%= Rack::Utils.escape_path(account) %>/<%= h.(period) %>">Ver estado de cuenta</a></p>
  <% end %>

  <pre><%= h.(job.output) %></pre>

  <p><a href="/jobs">Jobs</a> · <a href="/">Regresar</a></p>
</body>
</html>
