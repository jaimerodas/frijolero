# Copy to .env. bin/dev reads it. Every other line is optional.

# The ledger clone to serve. bin/dev then keeps its data (the database, the job log, the
# uploads) in tmp/dev. Without it, bin/dev keeps everything in ~/.local/share/frijolero and
# creates a ledger there on the first run.
#LEDGER_REPO=/ruta/a/tu/ledger

# The main file of that ledger: the app appends to it and the reports read it. Read once, on
# the first boot, which records it in the database. Default: main.beancount
#LEDGER_MAIN_FILE=main.beancount

# The email of the first admin, made on the first boot. Default in bin/dev: admin@localhost
#ADMIN_EMAIL=

# The address of the app, for the links in the sign-in emails. Default in bin/dev:
# http://localhost:$PORT
#APP_URL=

# Signs the session cookie: 64 bytes or more. Default in bin/dev: a fixed value, so a
# restart keeps the session. Make one with: openssl rand -hex 64
#SESSION_SECRET=

# Sends the sign-in emails through Postmark. Without the token, the link appears in the
# log, which is the terminal of bin/dev. Keep the quotes: this file is shell.
#POSTMARK_API_TOKEN=
#MAIL_FROM="Frijolero <frijolero@example.com>"

# Default: 3000
#PORT=3000

# The rustledger binary for the reports (brew install rustledger). Default: rledger on PATH
#RLEDGER=rledger

# Where the PDFs go: any S3-compatible bucket (B2, AWS, R2, Hetzner, DigitalOcean, MinIO).
# Without these four, they stay on disk, in the pdfs/ directory of each ledger.
#S3_ENDPOINT=s3.us-west-000.backblazeb2.com
#S3_BUCKET=
#S3_KEY_ID=
#S3_KEY=
# Optional. Region for the signature: taken from the endpoint (B2, AWS) when unset;
# R2 wants auto, Hetzner its location, DigitalOcean and MinIO us-east-1.
#S3_REGION=
# Optional. 1 puts the bucket in the path (endpoint/bucket/key) instead of the host.
#S3_PATH_STYLE=

# Needed to classify and extract. An upload spends money and commits to the ledger.
# LLM_PROVIDER is openai (default) or anthropic; the key is the one of that provider.
# The model names live in prompts/*/spec.json of this repo.
#LLM_PROVIDER=openai
#OPENAI_API_KEY=
#ANTHROPIC_API_KEY=
