# Copy to .env. bin/dev reads it. Every line is optional.

# The ledger clone to serve. Default: ~/Developer/beancount-ledger
#LEDGER_REPO=/Users/you/Developer/beancount-ledger

# Basic auth password, any username. Default: x
#APP_PASSWORD=x

# Default: 3000
#PORT=3000

# The rustledger binary for the reports (brew install rustledger). Default: rledger on PATH
#RLEDGER=rledger

# Needed for the account pages under Cuentas and for the PDF links.
#B2_ENDPOINT=s3.us-west-000.backblazeb2.com
#B2_BUCKET=
#B2_KEY_ID=
#B2_KEY=

# Needed to classify and extract. An upload spends money and commits to the ledger.
#OPENAI_API_KEY=
