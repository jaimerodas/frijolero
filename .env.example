# Copy to .env. bin/dev reads it. Every other line is optional.

# The ledger clone to serve. Without it, bin/dev keeps one in ~/.local/share/frijolero/ledger
# and creates it on the first run.
#LEDGER_REPO=/ruta/a/tu/ledger

# The main file of the ledger: the app appends to it and the reports read it. Default: main.beancount
#LEDGER_MAIN_FILE=main.beancount

# Login password. Default: x
#APP_PASSWORD=x

# Default: 3000
#PORT=3000

# The rustledger binary for the reports (brew install rustledger). Default: rledger on PATH
#RLEDGER=rledger

# Where the PDFs go. Without these four, they stay on disk next to the ledger, in pdfs/.
#B2_ENDPOINT=s3.us-west-000.backblazeb2.com
#B2_BUCKET=
#B2_KEY_ID=
#B2_KEY=

# Needed to classify and extract. An upload spends money and commits to the ledger.
#OPENAI_API_KEY=
