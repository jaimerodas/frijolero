#!/usr/bin/env ruby
# frozen_string_literal: true

# Crea un ledger para Frijolero, o prepara uno que ya existe. Agrega lo que
# falte: config/accounts.yaml, config/rules/, accounts/ y, si el directorio no
# tiene ningún .beancount, main.beancount. Nunca toca un archivo que ya está.
# Hace git init si hace falta y un commit con lo agregado. Los prompts son de la
# app (prompts/), no del ledger. El trabajo lo hace Frijolero::NewLedger, el mismo
# que usa la app.
#
# Uso: bin/new-ledger <directorio>

# Only these two files, which need no gem of the Gemfile: bin/dev runs this script
# outside `bundle exec`.
require_relative '../lib/ledger_repo'
require_relative '../lib/new_ledger'

dir = ARGV.first.to_s
abort 'uso: bin/new-ledger <directorio>' if dir.empty?

fresh = !File.directory?(dir)
message = nil
main = Frijolero::NewLedger.prepare(dir) { |committed| message = committed }
unless message
  puts "#{dir} ya tiene todo: nada que agregar."
  exit
end

if fresh
  puts "Ledger creado en #{dir}. Sin remoto, los commits se quedan aquí."
else
  puts %(Ledger preparado en #{dir}: commit "#{message}".)
  unless main == 'main.beancount'
    puts "Tu archivo principal es #{main}: pon LEDGER_MAIN_FILE=#{main} en .env y en el servidor."
  end
end
puts 'Para tenerlo en GitHub y en un servidor, agrega un remoto y haz push:'
puts %(  git -C "#{dir}" remote add origin <url>)
puts %(  git -C "#{dir}" push -u origin main)
