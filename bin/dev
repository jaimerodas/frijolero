#!/bin/sh
# Runs the app on the laptop. Reads .env if it exists (KEY=VALUE lines, see
# .env.example). DATA_DIR holds the database and ledgers/<id>/. On its first boot,
# the app adopts a ledger of the single-user layout, LEDGER_DIR, and moves it under
# ledgers/. Where DATA_DIR is:
#   - With LEDGER_DIR from the shell (a demo ledger): its parent directory.
#   - With LEDGER_REPO: tmp/dev, which reaches the checkout through a symlink, so
#     the job log, the PDFs and the uploads land in tmp/dev, not next to the repo.
#   - Else: the user's data directory, where the first run creates a ledger.
set -e
cd "$(dirname "$0")/.."

# A LEDGER_DIR from the shell wins over .env, main file included, so a demo ledger
# does not inherit the LEDGER_MAIN_FILE of the real one.
shell_dir="$LEDGER_DIR"
shell_main="$LEDGER_MAIN_FILE"

if [ -f .env ]; then
  set -a
  . ./.env
  set +a
fi

if [ -n "$shell_dir" ]; then
  DATA_DIR="$(cd "$(dirname "$shell_dir")" && pwd)"
  export DATA_DIR
  export LEDGER_DIR="$DATA_DIR/$(basename "$shell_dir")"
  export LEDGER_MAIN_FILE="${shell_main:-main.beancount}"
elif [ -z "$LEDGER_REPO" ]; then
  export DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/frijolero"
  export LEDGER_DIR="$DATA_DIR/ledger"
  [ -d "$DATA_DIR/ledgers" ] || [ -d "$LEDGER_DIR" ] || bin/new-ledger "$LEDGER_DIR"
else
  export DATA_DIR="$PWD/tmp/dev"
  export LEDGER_DIR="$DATA_DIR/ledger"
  mkdir -p "$DATA_DIR"
  [ -d "$DATA_DIR/ledgers" ] || ln -sfn "$LEDGER_REPO" "$LEDGER_DIR"
fi

export ADMIN_EMAIL="${ADMIN_EMAIL:-admin@localhost}"
export PORT="${PORT:-3000}"
export APP_URL="${APP_URL:-http://localhost:$PORT}"
# Fixed, so a restart keeps the session. rack-session needs 64 bytes or more.
export SESSION_SECRET="${SESSION_SECRET:-frijolero-development-session-secret-for-bin-dev-only-never-production}"
export RACK_ENV="${RACK_ENV:-development}"

echo "frijolero on $APP_URL (data: $DATA_DIR)"
echo "sign in with $ADMIN_EMAIL: without POSTMARK_API_TOKEN, the link appears in this terminal"
exec bundle exec puma -C config/puma.rb config.ru
