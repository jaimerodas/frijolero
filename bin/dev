#!/bin/sh
# Runs the app on the laptop. Reads .env if it exists (KEY=VALUE lines, see
# .env.example). Without LEDGER_REPO, the ledger lives in the user's data
# directory and the first run creates it. With it, the checkout is reached
# through tmp/dev/ledger, so the job log, the PDFs and the uploads land in
# tmp/dev instead of next to the repo.
set -e
cd "$(dirname "$0")/.."

# A LEDGER_DIR from the shell wins over .env, main file included, so a demo ledger
# does not inherit the LEDGER_MAIN_FILE of the real one.
shell_dir="$LEDGER_DIR"
shell_main="$LEDGER_MAIN_FILE"

if [ -f .env ]; then
  set -a
  . ./.env
  set +a
fi

if [ -n "$shell_dir" ]; then
  export LEDGER_DIR="$shell_dir"
  export LEDGER_MAIN_FILE="${shell_main:-main.beancount}"
elif [ -z "$LEDGER_REPO" ]; then
  data="${XDG_DATA_HOME:-$HOME/.local/share}/frijolero"
  [ -d "$data/ledger" ] || bin/new-ledger "$data/ledger"
  export LEDGER_DIR="$data/ledger"
else
  mkdir -p tmp/dev
  ln -sfn "$LEDGER_REPO" tmp/dev/ledger
  export LEDGER_DIR="$PWD/tmp/dev/ledger"
fi

main="$LEDGER_DIR/${LEDGER_MAIN_FILE:-main.beancount}"
if [ ! -f "$main" ]; then
  echo "No existe $main." >&2
  echo "Si tu archivo principal tiene otro nombre, pon LEDGER_MAIN_FILE en .env. Archivos .beancount en el ledger:" >&2
  ls "$LEDGER_DIR"/*.beancount >&2 2>/dev/null || echo "  ninguno: corre bin/new-ledger \"$LEDGER_DIR\"" >&2
  exit 1
fi

export APP_PASSWORD="${APP_PASSWORD:-x}"
export PORT="${PORT:-3000}"
export RACK_ENV="${RACK_ENV:-development}"

echo "frijolero on http://localhost:$PORT (password: $APP_PASSWORD, ledger: $LEDGER_DIR)"
exec bundle exec puma -C config/puma.rb config.ru
