#!/usr/bin/env ruby
# frozen_string_literal: true

# Crea un ledger de demostración con datos inventados: tres cuentas en bancos con
# nombres de dioses griegos, dos años de estados de cuenta, reglas, aserciones de
# saldo, PDFs de relleno y una bitácora. Cada estado de cuenta pasa por el mismo
# detailer, convertidor y merger que un job real, así que la app lo muestra igual.
#
# Uso: bin/demo-ledger <dir> [--persona employee|contractor] [--income 40000] [--months 24] [--seed N]
# Después: LEDGER_DIR=<dir>/ledger bin/dev

require 'optparse'
require 'json'
require 'date'
require 'securerandom'
require 'time'
require 'yaml'
require 'fileutils'

$LOAD_PATH.unshift File.expand_path('../lib', __dir__)
require 'frijolero'

options = { persona: 'employee', income: 40_000, months: 24, seed: Random.new_seed % 100_000 }
OptionParser.new do |o|
  o.banner = 'uso: bin/demo-ledger <dir> [opciones]'
  o.on('--persona P', %w[employee contractor], 'employee (default) o contractor')
  o.on('--income N', Integer, 'ingreso neto mensual en MXN (default 40000)')
  o.on('--months N', Integer, 'meses de historia, hasta el mes pasado (default 24)')
  o.on('--seed N', Integer, 'semilla; la misma semilla da el mismo ledger (default: al azar)')
end.parse!(into: options)
DIR = ARGV[0] or abort 'uso: bin/demo-ledger <dir> [opciones]'
abort "#{DIR} ya existe" if File.exist?(DIR)

Config = Frijolero::Config

# --- Catalog. Amounts are pesos at a 40,000 MXN take-home; `fixed` ones never scale.
BASE_INCOME = 40_000
CITIES = %w[CDMX GUADALAJARA MONTERREY MEXICO MX].freeze
ACCOUNTS = {
  'Zeus' => { 'beancount_account' => 'Assets:Banco-Zeus:Cheques', 'openai_prompt_type' => 'default',
              'description' => 'Cuenta de cheques en Banco Zeus' },
  'Hera TDC' => { 'beancount_account' => 'Liabilities:Hera:Tarjeta', 'openai_prompt_type' => 'default',
                  'description' => 'Tarjeta de crédito Hera', 'cutoff_day' => 20 },
  'Atenea' => { 'beancount_account' => 'Assets:Atenea:Ahorro', 'openai_prompt_type' => 'default',
                'description' => 'Cuenta de ahorro en Atenea' }
}.freeze
# [prefix, payee, account, per month, pesos, fixed]
CARD = [
  ['WAL-MART SUPERCENTER', 'Walmart', 'Expenses:Comida:Super', 2..3, 900..2200],
  ['SORIANA HIPER', 'Soriana', 'Expenses:Comida:Super', 0..1, 500..1500],
  ['LA COMER', 'La Comer', 'Expenses:Comida:Super', 0..2, 400..1300],
  ['OXXO', 'Oxxo', 'Expenses:Comida:Tiendita', 2..6, 45..260],
  ['7-ELEVEN', '7-Eleven', 'Expenses:Comida:Tiendita', 0..2, 40..180],
  ['STARBUCKS', 'Starbucks', 'Expenses:Comida:Cafe', 1..5, 75..190],
  ['RAPPI', 'Rappi', 'Expenses:Comida:Delivery', 1..4, 180..520],
  ['UBER *EATS', 'Uber Eats', 'Expenses:Comida:Delivery', 0..3, 160..480],
  ['REST CONTRAMAR', 'Contramar', 'Expenses:Comida:Restaurantes', 0..1, 900..2200],
  ['TAQUERIA ORINOCO', 'Taquería Orinoco', 'Expenses:Comida:Restaurantes', 0..3, 180..450],
  ['FONDA MARGARITA', 'Fonda Margarita', 'Expenses:Comida:Restaurantes', 0..2, 150..400],
  ['SUSHI ROLL', 'Sushi Roll', 'Expenses:Comida:Restaurantes', 0..1, 350..800],
  ['TOKS', 'Toks', 'Expenses:Comida:Restaurantes', 0..2, 220..600],
  ['UBER *TRIP', 'Uber', 'Expenses:Transporte', 2..8, 60..320],
  ['DIDI RIDES', 'DiDi', 'Expenses:Transporte', 0..3, 50..250],
  ['PEMEX GASOLINERA', 'Pemex', 'Expenses:Transporte:Gasolina', 1..3, 600..1100],
  ['NETFLIX.COM', 'Netflix', 'Expenses:Suscripciones', 1..1, 299, true],
  ['SPOTIFY', 'Spotify', 'Expenses:Suscripciones', 1..1, 129, true],
  ['APPLE.COM/BILL', 'Apple', 'Expenses:Suscripciones', 1..1, 49, true],
  ['AMAZON PRIME MX', 'Amazon', 'Expenses:Suscripciones', 1..1, 99, true],
  ['SMART FIT', 'Smart Fit', 'Expenses:Salud:Gimnasio', 1..1, 649, true],
  ['FARMACIAS DEL AHORRO', 'Farmacias del Ahorro', 'Expenses:Salud', 0..2, 120..900],
  ['AMAZON MX MARKETPLACE', 'Amazon', 'Expenses:Compras', 0..3, 250..2400],
  ['MERCADO LIBRE', 'Mercado Libre', 'Expenses:Compras', 0..2, 200..3000],
  ['LIVERPOOL', 'Liverpool', 'Expenses:Compras:Ropa', 0..1, 800..3500],
  ['CINEPOLIS', 'Cinépolis', 'Expenses:Entretenimiento', 0..2, 180..520],
  ['STEAM PURCHASE', 'Steam', 'Expenses:Entretenimiento', 0..1, 150..900]
].freeze
TRAVEL = [['AEROMEXICO', 'Aeroméxico', 2500..7800], ['AIRBNB', 'Airbnb', 3000..9000],
          ['VOLARIS', 'Volaris', 1200..4200]].freeze
CHECKING = [
  ['TELMEX PAGO DE SERVICIO', 'Telmex', 'Expenses:Vivienda:Servicios', 1..1, 499, true],
  ['NATURGY MEXICO', 'Naturgy', 'Expenses:Vivienda:Servicios', 1..1, 250..600],
  ['RETIRO CAJERO ATM', nil, 'Expenses:Efectivo', 0..2, 500..2000]
].freeze
# Merchants with no rule, only in the last two card statements, so there is something to classify live.
UNRULED = ['MERCADO DE SAN JUAN LOC 12', 'FERRETERIA EL CLAVO', 'PANADERIA ROSETTA', 'VETERINARIA PATITAS',
           'PAYPAL *KINDLE'].freeze
CLIENTS = ['ATLAS CONSULTING', 'HELIOS DIGITAL', 'ARGOS MEDIA'].freeze
TAX_RATE = 0.18
SAVINGS_RATE = 0.07

RNG = Random.new(options[:seed])
SCALE = options[:income].to_f / BASE_INCOME

def cents(pesos, fixed: false)
  value = pesos.is_a?(Range) ? RNG.rand(pesos.first.to_f..pesos.last.to_f) : pesos.to_f
  ((fixed ? value : value * SCALE) * 100).round
end

def day_in(from, to) = from + RNG.rand((to - from + 1).to_i)

def row(date, description, amount_cents)
  { 'date' => date.iso8601, 'description' => description, 'amount' => amount_cents / 100.0, 'currency' => 'MXN' }
end

def titled(prefix) = prefix.split.map(&:capitalize).join(' ')

def pick(catalog, from, to)
  catalog.flat_map do |prefix, _, _, per_month, pesos, fixed|
    RNG.rand(per_month).times.map do
      row(day_in(from, to), "#{prefix} #{CITIES.sample(random: RNG)}", -cents(pesos, fixed: fixed))
    end
  end
end

# Card charges between two dates.
def card_rows(from, to, with_unruled:)
  rows = pick(CARD, from, to)
  if RNG.rand < 0.2
    TRAVEL.sample(RNG.rand(1..2), random: RNG).each do |prefix, _, pesos|
      rows << row(day_in(from, to), "#{prefix} MEXICO", -cents(pesos))
    end
  end
  return rows unless with_unruled

  UNRULED.sample(RNG.rand(1..2), random: RNG).each { |name| rows << row(day_in(from, to), name, -cents(150..1200)) }
  rows
end

def payroll_rows(month, income_cents)
  rows = [row(Date.new(month.year, month.month, 15), 'NOMINA CORPORATIVO OLIMPO SA DE CV QUINCENA 1', income_cents / 2),
          row(Date.new(month.year, month.month, -1), 'NOMINA CORPORATIVO OLIMPO SA DE CV QUINCENA 2',
              income_cents - (income_cents / 2))]
  return [rows, 0] unless month.month == 12

  rows << row(Date.new(month.year, 12, 15), 'AGUINALDO CORPORATIVO OLIMPO SA DE CV', income_cents / 2)
  [rows, 0]
end

# Invoices that add up to the take-home plus the tax paid on them next month, with noise.
def invoice_rows(month, income_cents, last_deposits)
  gross = (income_cents / (1 - TAX_RATE) * RNG.rand(0.75..1.4)).round
  parts = RNG.rand(1..3)
  rows = parts.times.map do |i|
    amount = i == parts - 1 ? gross - (gross / parts * i) : gross / parts
    client = CLIENTS.sample(random: RNG)
    row(day_in(month, Date.new(month.year, month.month, -1)),
        "SPEI RECIBIDO #{client} SA DE CV FACTURA A-#{RNG.rand(1000..9999)}", amount)
  end
  if last_deposits.positive?
    rows << row(Date.new(month.year, month.month, 17), 'SAT PAGO REFERENCIADO ISR E IVA',
                -(last_deposits * TAX_RATE).round)
  end
  [rows, gross]
end

def checking_rules
  rules = CHECKING.to_h { |prefix, payee, account, *| [prefix, { 'payee' => payee, 'account' => account }.compact] }
  rules['SPEI ENVIADO INMOBILIARIA HESTIA'] =
    { 'payee' => 'Inmobiliaria Hestia', 'narration' => 'Renta', 'account' => 'Expenses:Vivienda:Renta' }
  rules['TRASPASO A CUENTA ATENEA'] = { 'narration' => 'Ahorro mensual', 'account' => 'Assets:Atenea:Ahorro' }
  rules['PAGO TARJETA HERA'] = { 'narration' => 'Pago de TDC Hera', 'account' => 'Liabilities:Hera:Tarjeta' }
  rules['CFE SUMINISTRADOR'] = { 'payee' => 'CFE', 'narration' => 'Luz', 'account' => 'Expenses:Vivienda:Servicios' }
  %w[NOMINA AGUINALDO].each do |kind|
    rules["#{kind} CORPORATIVO OLIMPO"] =
      { 'payee' => 'Corporativo Olimpo', 'narration' => kind == 'NOMINA' ? 'Sueldo' : 'Aguinaldo',
        'account' => 'Income:Sueldo' }
  end
  CLIENTS.each do |c|
    rules["SPEI RECIBIDO #{c}"] =
      { 'payee' => titled(c), 'narration' => 'Honorarios', 'account' => 'Income:Honorarios' }
  end
  rules['SAT PAGO REFERENCIADO'] = { 'payee' => 'SAT', 'narration' => 'Impuestos', 'account' => 'Expenses:Impuestos' }
  rules
end

def rules
  card = CARD.to_h { |prefix, payee, account, *| [prefix, { 'payee' => payee, 'account' => account }] }
  TRAVEL.each { |prefix, payee, _| card[prefix] = { 'payee' => payee, 'account' => 'Expenses:Viajes' } }
  { 'Zeus' => { 'start_with' => checking_rules }, 'Hera TDC' => { 'start_with' => card },
    'Atenea' => { 'start_with' => { 'INTERESES GANADOS' => { 'narration' => 'Intereses',
                                                             'account' => 'Income:Intereses' } } } }
end

# A one-page PDF that says what it is. Nothing else reads it.
def pdf(lines)
  text = lines.map { |l| "(#{l.gsub(/[()\\]/) { "\\#{it}" }}) '" }.join(' ')
  content = "BT /F1 14 Tf 72 740 Td 20 TL #{text} ET"
  objects = ['<< /Type /Catalog /Pages 2 0 R >>', '<< /Type /Pages /Kids [3 0 R] /Count 1 >>',
             '<< /Type /Page /Parent 2 0 R /MediaBox [0 0 612 792] /Contents 4 0 R ' \
             '/Resources << /Font << /F1 5 0 R >> >> >>',
             "<< /Length #{content.bytesize} >>\nstream\n#{content}\nendstream",
             '<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>']
  out = +"%PDF-1.4\n"
  offsets = objects.map.with_index(1) { |o, i| out.bytesize.tap { out << "#{i} 0 obj\n#{o}\nendobj\n" } }
  xref = out.bytesize
  table = offsets.map { format('%010d 00000 n ', it) }.join("\n")
  out << "xref\n0 #{objects.size + 1}\n0000000000 65535 f \n#{table}\n"
  out << "trailer\n<< /Size #{objects.size + 1} /Root 1 0 R >>\nstartxref\n#{xref}\n%%EOF\n"
end

def write_pdf(key, period)
  path = File.join(Config.pdfs_dir, Config.pdf_key(key, period))
  FileUtils.mkdir_p(File.dirname(path))
  bank = ACCOUNTS[key]['description'].split(' en ').last
  File.write(path, pdf([bank, "Estado de cuenta #{key} #{period}", '', 'Documento de demostracion.',
                        'Los movimientos son inventados.']))
end

# Writes one statement the way a job does: JSON, rules, .beancount, include, PDF. Returns the job entry.
def statement(key, period, rows, uploaded_on)
  json = Config.statement_path(key, period, 'json')
  beancount = Config.statement_path(key, period, 'beancount')
  FileUtils.mkdir_p(File.dirname(json))
  File.write(json, JSON.pretty_generate({ 'transactions' => rows.sort_by { it['date'] } }))
  stats = Frijolero::Detailer.new(json, Config.rules_path(key)).run
  Frijolero::Pipeline.for(Config.accounts[key]).convert(json_path: json, output: beancount)
  Frijolero::BeancountMerger.merge(beancount)
  write_pdf(key, period)
  output = ["Extracted transactions (#{RNG.rand(20.0..90.0).round(1)}s)",
            "Saved JSON: #{Frijolero::Log.short_path(json)}",
            "#{stats[:detailed].size} detailed", "#{stats[:remaining].size} remaining",
            "Saved Beancount: #{Frijolero::Log.short_path(beancount)}", 'Merged into: main.beancount'].join("\n")
  started = Time.utc(uploaded_on.year, uploaded_on.month, uploaded_on.day, RNG.rand(8..22), RNG.rand(60))
  { id: SecureRandom.hex(8), label: "#{key} #{period}", status: 'ok', started_at: started.iso8601,
    finished_at: (started + RNG.rand(30..120)).iso8601, output: output }
end

def mxn(cents) = format('%.2f', cents / 100.0)

# --- Build.
ledger = File.join(DIR, 'ledger')
git_env = ENV.keys.grep(/\AGIT_/).to_h { |k| [k, nil] }
system(git_env, File.expand_path('new-ledger', __dir__), ledger, out: File::NULL, exception: true)
ENV['LEDGER_DIR'] = ledger

today = Date.today
last_month = Date.new(today.year, today.month, 1).prev_month
months = (0...options[:months]).map { |i| last_month << (options[:months] - 1 - i) }
first_date = Date.new(months.first.year, months.first.month, 21).prev_month # the first card statement starts here
income_cents = options[:income] * 100

accounts_yaml = ACCOUNTS.reduce('') { |text, (key, entry)| Frijolero::NewAccount.append_block(text, key, entry) }
File.write(Config.accounts_file, accounts_yaml)
rules.each { |key, config| File.write(Config.rules_path(key), YAML.dump(config)) }
opens = ACCOUNTS.values.map { it['beancount_account'] } + %w[Equity:Apertura Expenses:FIXME]
opens += rules.values.flat_map { |c| c['start_with'].values.filter_map { it['account'] } }
opens.uniq.sort.each { |account| Frijolero::NewAccount.add_open_line(Config.account_opens_file, first_date, account) }

zeus = (income_cents * 1.5).round
atenea = (income_cents * 3).round
hera = 0
File.open(Config.main_file, 'a') do |f|
  f.puts "\ninclude \"balances.beancount\"\n\n#{first_date.iso8601} * \"Saldos iniciales\""
  f.puts "  Assets:Banco-Zeus:Cheques  #{mxn(zeus)} MXN"
  f.puts "  Assets:Atenea:Ahorro  #{mxn(atenea)} MXN\n  Equity:Apertura\n"
end

jobs = []
balances = []
last_deposits = 0
months.each_with_index do |month, i|
  period = month.strftime('%y%m')
  last = Date.new(month.year, month.month, -1)
  payment = -hera # Zeus pays the card statement that closed last month on the 8th, before this one closes
  hera += payment

  # Hera: the 21st of the previous month to the 20th of this one.
  rows = card_rows(Date.new(month.year, month.month, 21).prev_month, Date.new(month.year, month.month, 20),
                   with_unruled: i >= months.size - 2)
  hera += rows.sum { (it['amount'] * 100).round }
  jobs << statement('Hera TDC', period, rows, Date.new(month.year, month.month, 22))
  balances << "#{Date.new(month.year, month.month, 21).iso8601} balance Liabilities:Hera:Tarjeta #{mxn(hera)} MXN"

  # Zeus: the calendar month. Transfers appear only here, as a careful ledger keeps them.
  rows, last_deposits = if options[:persona] == 'employee'
                          payroll_rows(month, income_cents)
                        else
                          invoice_rows(month, income_cents, last_deposits)
                        end
  rent = "SPEI ENVIADO INMOBILIARIA HESTIA REF RENTA #{month.strftime('%m%y')}"
  rows << row(Date.new(month.year, month.month, 1), rent,
              -(income_cents * 0.30).round)
  savings = (income_cents * 0.10).round
  rows << row(Date.new(month.year, month.month, 2), 'TRASPASO A CUENTA ATENEA ****8841', -savings)
  rows << row(Date.new(month.year, month.month, 8), 'PAGO TARJETA HERA ****4521', -payment) if payment.positive?
  if month.month.even?
    rows << row(day_in(Date.new(month.year, month.month, 10), Date.new(month.year, month.month, 14)),
                'CFE SUMINISTRADOR DE SERVICIOS BASICOS', -cents(600..1400))
  end
  rows.concat(pick(CHECKING, month, last))
  zeus += rows.sum { (it['amount'] * 100).round }
  jobs << statement('Zeus', period, rows, last + RNG.rand(2..4))
  balances << "#{(last + 1).iso8601} balance Assets:Banco-Zeus:Cheques #{mxn(zeus)} MXN"

  # Atenea: the transfer in is already posted from Zeus; the statement adds the interest.
  interest = (atenea * SAVINGS_RATE / 12).round
  atenea += savings + interest
  jobs << statement('Atenea', period, [row(last, 'INTERESES GANADOS', interest)], last + RNG.rand(3..5))
  balances << "#{(last + 1).iso8601} balance Assets:Atenea:Ahorro #{mxn(atenea)} MXN"
end
File.write(File.join(ledger, 'balances.beancount'), "#{balances.join("\n")}\n")

# The job log, in upload order, with one failed attempt so the Bitácora shows that state too.
jobs.sort_by! { it[:started_at] }
second_try = Time.iso8601(jobs.last[:started_at])
failed = jobs.last.merge(id: SecureRandom.hex(8), status: 'failed', error: 'RuntimeError: Statement terminó con error',
                         started_at: (second_try - 600).iso8601, finished_at: (second_try - 540).iso8601,
                         output: "Extracted transactions: rate limited by OpenAI (429)\n" \
                                 "✗ ERROR processing #{jobs.last[:label]}.pdf")
jobs.insert(-2, failed)
FileUtils.mkdir_p(Config.data_dir)
File.write(Config.jobs_file, "#{jobs.map { JSON.generate(it) }.join("\n")}\n")

errors = Frijolero::Reports.check
abort "rledger check: #{errors.map { "#{it[:message]} (#{it[:file]}:#{it[:line]})" }.join("\n")}" unless errors.empty?

system(git_env, 'git', '-C', ledger, 'add', '-A', exception: true)
system(git_env, 'git', '-C', ledger, '-c', 'user.name=Frijolero', '-c', 'user.email=frijolero@localhost',
       'commit', '-qm', 'Ledger de demostración', exception: true)
puts "Ledger de demostración en #{ledger}: #{options[:persona]}, #{options[:income]} MXN al mes, " \
     "#{months.first.strftime('%Y-%m')} a #{last_month.strftime('%Y-%m')}, semilla #{options[:seed]}."
puts "Para verlo: LEDGER_DIR=#{ledger} bin/dev"
